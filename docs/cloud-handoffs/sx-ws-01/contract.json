      "dialog-open",
      "hover",
      "focus",
      "observation-age",
      "audio-playback"
    ],
    "history": {
      "open_call": "push",
      "successful_new_upload_call_binding": "replace",
      "section": "replace-without-scroll",
      "background_stage": "no-history-change",
      "dialog": "no-URL-change; explicit-close-or-Escape",
      "library_filter_sort": "push-on-explicit-commit",
      "library_search": "local-only-until-scoped-search-supported"
    },
    "loading": "neutral static/hydration shell; parse intent before choosing upload; owner-checked direct report"
  },
  "local": {
    "upstream": "fixed existing VPS bridge; no public API response substitution",
    "control_page": "/__review/",
    "presentation_port": "default live pass-through; exact dev-Webpack alias to local adapter only",
    "modes": {
      "live": "current real authorized observations, ordinary controller; review process blocks business writes",
      "observed": "previous real response set and captured UI state; fresh authorization; no operational rewind",
      "presentation": "authorized real base plus allowlisted UI-only selection; no invented workflow or language content"
    },
    "guard": "bridge policy read-only-review set at process launch, not per-tab query",
    "auth_exceptions": [
      "ordinary explicit login",
      "ordinary explicit logout",
      "ordinary explicit workspace selection"
    ],
    "public_api_business_writes": "deny all POST PUT PATCH DELETE acquisition/intake/recording/run commands including quote",
    "capture": "opt-in, read-response minimum, memory-only first slice; no HAR/storage-state/audio capture",
    "limits_proposed": {
      "active_calls_per_handle": 1,
      "frames": 128,
      "ui_events": 256,
      "unique_json_bytes": 16777216,
      "max_json_response_bytes": 4194304,
      "hard_ttl_seconds": 1800,
      "authorization_lease_seconds": 30,
      "command_queue": 16,
      "command_json_bytes": 16384,
      "note_characters": 2000,
      "later_replay_max_events": 32
    },
    "expiry": "earliest local hard TTL, lost ownership/session, actual resource retention/invalidation; mask on uncertainty",
    "historical_report_rule": "current resource access alone is insufficient; exact artifact still authorized/retrievable or unavailable",
    "time_rule": "never globally fake Date/timers in live bridge; pure presentation age only in labeled presentation mode",
    "reset": "new page/view generation; abort reads, pause audio, reset local UI; preserve session only within same owner/tenant; never replay writes",
    "control_security": [
      "exact host/origin checks",
      "same-origin CSRF protection for commands",
      "no arbitrary URLs/selectors/JS/file paths",
      "bounded typed commands",
      "auth-bound opaque references not capabilities",
      "no CORS wildcard",
      "keep X-Frame-Options DENY"
    ]
  },
