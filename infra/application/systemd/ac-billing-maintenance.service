[Unit]
Description=Enqueue internal billing capacity expiry v1
After=network-online.target
Wants=network-online.target
# Root release controls mount the immutable API image and supply runtime configuration.
ConditionPathExists=/etc/authority-closers/billing-maintenance-enabled

[Service]
Type=oneshot
User=10001
Group=10001
RootDirectory=/srv/authority-closers/billing-maintenance/rootfs
WorkingDirectory=/app
EnvironmentFile=/etc/authority-closers/billing-maintenance.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/app/.venv/bin/python -m ac_platform.payments.cli enqueue-expiry --environment ${AC_ENVIRONMENT}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=256M
CPUQuota=25%
TasksMax=32
TimeoutStartSec=15min
