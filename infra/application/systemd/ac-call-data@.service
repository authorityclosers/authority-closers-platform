[Unit]
Description=Sales Xray call data engine, fast pipeline (%i)
Documentation=file:///home/acdev/src/dev-live/authority-closers-platform/docs/architecture/CALL_DATA_ENGINE.md
After=network-online.target docker.service

[Service]
Type=exec
ExecStart=/usr/local/sbin/ac-call-data %i
# The runner lives inside the worker on staging and production; stop it there too.
ExecStop=/usr/local/sbin/ac-call-data stop %i
Restart=always
RestartSec=15s
# Pick up each new release: restart at least every 30 minutes (the runner holds no state).
RuntimeMaxSec=30min
Nice=10
MemoryMax=384M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
