[Unit]
Description=Bug radar: every Sales X-Ray review screen checked on GitHub's runners, kept as AC Pulse cards (development)
Documentation=file:///home/acdev/src/dev-live/authority-closers-platform/docs/ops/BUG-RADAR.md
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ac-bug-radar nightly
Nice=10
IOSchedulingClass=idle
