#!/bin/bash
# Sales Xray one-pass trial (owner, 21 Oct 2026): when Admin -> Providers sets this
# environment's analysis pipeline to "both", every NEW call that today's pipeline
# transcribed is also read the Google-only way (Gemini 3.1 Flash-Lite transcription,
# one Gemini 3.8 Flash pass), side by side; people keep seeing today's results.
# Long-running (systemd restarts it); one runner per database (advisory lock).
#
# Development only: staging and production stay on today's pipeline until the owner
# decides, so this wrapper refuses them. Never backfills: the first start records a
# moment once (/var/lib/ac-one-pass/<env>.since) and only transcripts saved after it
# (and in the last two hours) are read. Spend: Admin -> AI spend -> One-pass trial cap
# (Rs 0 until raised; raising it is the approval). Docs:
# docs/architecture/ONE_PASS_ANALYSIS.md
#
#   ac-one-pass development-live
set -euo pipefail

module=ac_platform.one_pass.runner
state=${ONE_PASS_STATE:-/var/lib/ac-one-pass}

env_name=${1:?usage: ac-one-pass development-live}
if [[ $env_name != development-live ]]; then
  echo "the one-pass trial runs on development only" >&2
  exit 2
fi
install -d -m 700 "$state"

since_file=$state/$env_name.since
[ -s "$since_file" ] || date -u +%Y-%m-%dT%H:%M:%S+00:00 > "$since_file"
since=$(cat "$since_file")

slot=$(cat /var/lib/ac-dev-live-backend/active-slot)
python=/srv/authority-closers/development/live-backend/$slot/.venv/bin/python
cd /tmp
if ! env -i PATH=/usr/bin:/bin "$python" -c "import $module" 2>/dev/null; then
  echo "one-pass runner is not in this release yet"
  sleep 300
  exit 0
fi
exec env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/root LANG=C.UTF-8 PYTHONUNBUFFERED=1 \
  "$python" -m "$module" \
  --service-config /etc/authority-closers/development/service-live.json \
  --database-url-file /etc/authority-closers/development/database-url-live \
  --token-file /etc/authority-closers/development/identities/gemini/token \
  --infisical /usr/local/bin/infisical \
  --not-before "$since" --recent-hours 2 --loop --apply
