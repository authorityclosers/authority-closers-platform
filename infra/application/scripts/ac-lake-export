#!/usr/bin/python3 -I
"""Nightly Parquet export with verified S3 objects and manifest-last publication.

Install root-owned. No secrets in argv, disk, child output or diagnostics.
AC_LAKE_EXPORT_ENABLED defaults off, set only in root-owned per-environment config.
"""

from __future__ import annotations

import base64
import hashlib
import json
import os
import runpy
import subprocess
import sys
import tempfile
from contextlib import suppress
from datetime import UTC, date, datetime
from pathlib import Path

BUCKET = "ac-archive-283923228069-apse2"
REGION = "ap-southeast-2"
KEY_NAME = "AC_LAKE_HMAC_KEY_V1"
ENVIRONMENTS = ("dev", "staging", "production")
ARCHIVE_HELPER = "/usr/local/sbin/ac-archive-put"
PYTHON = "/opt/ac-lake-export/.venv/bin/python"
STATE = Path("/var/lib/ac-lake-export")


def credentials() -> dict[str, str]:
    # Reuse the archive helper's constrained Infisical login/HTTPS/no-redirect
    # implementation, asking for one additional fixed secret from prod /ops.
    reader = runpy.run_path(ARCHIVE_HELPER)["credentials"]
    reader.__globals__["SECRET_NAMES"] = (*reader.__globals__["SECRET_NAMES"], KEY_NAME)
    values = reader()
    if values["AC_ARCHIVE_BUCKET"] != BUCKET or values["AC_ARCHIVE_REGION"] != REGION:
        raise ValueError("archive target mismatch")
    if len(bytes.fromhex(values[KEY_NAME])) != 32:
        raise ValueError("invalid HMAC key")
    return values


def run(argv: list[str], env: dict[str, str]) -> str:
    result = subprocess.run(  # noqa: S603 - fixed argv, no shell or inherited environment
        argv,
        env=env,
        capture_output=True,
        text=True,
        timeout=1500,
        check=False,
        cwd="/",
    )
    if result.returncode:
        raise RuntimeError("lake worker or upload failed")
    return result.stdout


def upload(path: Path, key: str, env: dict[str, str]) -> None:
    digest = hashlib.sha256(path.read_bytes()).digest()
    encoded = base64.b64encode(digest).decode()
    run(
        [
            "/usr/local/bin/aws",
            "s3api",
            "put-object",
            "--bucket",
            BUCKET,
            "--key",
            key,
            "--body",
            str(path),
            "--server-side-encryption",
            "AES256",
            "--checksum-algorithm",
            "SHA256",
            "--checksum-sha256",
            encoded,
            "--content-type",
            "application/json" if path.suffix == ".json" else "application/vnd.apache.parquet",
        ],
        env,
    )
    metadata = json.loads(
        run(
            [
                "/usr/local/bin/aws",
                "s3api",
                "head-object",
                "--bucket",
                BUCKET,
                "--key",
                key,
                "--checksum-mode",
                "ENABLED",
                "--output",
                "json",
            ],
            env,
        )
    )
    if (
        metadata.get("ContentLength") != path.stat().st_size
        or metadata.get("ChecksumSHA256") != encoded
        or metadata.get("ServerSideEncryption") != "AES256"
    ):
        raise ValueError("lake remote verification failed")


def publish(output: Path, environment: str, day: str, env: dict[str, str]) -> int:
    if date.fromisoformat(day).isoformat() != day or environment not in ENVIRONMENTS:
        raise ValueError("invalid lake partition")
    manifests = []
    rows = 0
    # Check both tables fully before starting an upload. A manifest references
    # only verified content-addressed parts; interrupted runs leave no new commit marker.
    for table in ("analytics_events", "lead_desk_events"):
        folder = output / table
        path = folder / "manifest.json"
        manifest = json.loads(path.read_text())
        if (
            manifest["environment"] != environment
            or manifest["table"] != table
            or manifest["day"] != day
            or manifest["rows"] != sum(p["rows"] for p in manifest["parts"])
        ):
            raise ValueError("lake manifest mismatch")
        prefix = f"lake/{environment}/{table}/dt={day}/"
        for part in manifest["parts"]:
            key = part["key"]
            name = key.removeprefix(prefix)
            if (
                not key.startswith(prefix)
                or "/" in name
                or not name.startswith("part-")
                or not name.endswith(".parquet")
            ):
                raise ValueError("invalid lake part path")
            local = folder / name
            if (
                local.is_symlink()
                or local.stat().st_size != part["bytes"]
                or hashlib.sha256(local.read_bytes()).hexdigest() != part["sha256"]
            ):
                raise ValueError("lake local verification failed")
        rows += manifest["rows"]
        manifests.append((path, manifest, prefix))
    for path, manifest, prefix in manifests:
        for part in manifest["parts"]:
            upload(path.parent / part["key"].removeprefix(prefix), part["key"], env)
    for path, _, prefix in manifests:
        upload(path, prefix + "manifest.json", env)
    return rows


def reconciliation_status(environment: str, report: dict) -> None:
    root = (
        Path("/srv/authority-closers/sales-xray/development-live/telemetry")
        if environment == "dev"
        else Path("/var/lib/ac-telemetry")
    ) / environment
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = root / "reconciliation.tmp"
    with temporary.open("w") as handle:
        json.dump({**report, "checked_at": datetime.now(UTC).isoformat()}, handle)
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(root / "reconciliation.json")


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in ENVIRONMENTS:
        print("usage: ac-lake-export dev|staging|production", file=sys.stderr)
        return 2
    environment = argv[0]
    if os.environ.get("AC_LAKE_EXPORT_ENABLED") != "1":
        print(json.dumps({"environment": environment, "disabled": True}))
        return 0
    try:
        values = credentials()
        minimal = {"PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8", "HOME": "/root"}
        worker = {**minimal, "AC_LAKE_EXPORT_ENABLED": "1", KEY_NAME: values[KEY_NAME]}
        aws = {
            **minimal,
            "AWS_ACCESS_KEY_ID": values["AC_ARCHIVE_AWS_ACCESS_KEY_ID"],
            "AWS_SECRET_ACCESS_KEY": values["AC_ARCHIVE_AWS_SECRET_ACCESS_KEY"],
            "AWS_DEFAULT_REGION": REGION,
            "AWS_EC2_METADATA_DISABLED": "true",
            "AWS_CONFIG_FILE": "/dev/null",
            "AWS_SHARED_CREDENTIALS_FILE": "/dev/null",
            "AWS_PAGER": "",
        }
        database = os.environ.get("AC_LAKE_DATABASE_URL_FILE")
        if not database:
            raise ValueError("lake database not configured")
        with tempfile.TemporaryDirectory(prefix=f"{environment}-", dir=STATE) as directory:
            output = Path(directory)
            answer = json.loads(
                run(
                    [
                        PYTHON,
                        "-m",
                        "ac_platform.telemetry.lake_cli",
                        "--environment",
                        environment,
                        "--database-url-file",
                        database,
                        "--output",
                        str(output),
                    ],
                    worker,
                )
            )
            if answer["environment"] != environment:
                raise ValueError("lake worker environment mismatch")
            rows = publish(output, environment, answer["day"], aws)
            manifest = json.loads((output / "analytics_events" / "manifest.json").read_text())
            reconciliation_status(
                environment,
                {
                    **manifest["reconciliation"],
                    "day": answer["day"],
                    "verified": True,
                },
            )
            print(
                json.dumps(
                    {
                        "environment": environment,
                        "day": answer["day"],
                        "rows": rows,
                        "verified": True,
                    }
                )
            )
        return 0
    except Exception:
        with suppress(OSError):
            reconciliation_status(environment, {"verified": False, "mismatch": True})
        print("lake export failed; no unverified manifest is accepted", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
