#!/usr/bin/env python3
"""Weekly aggregate-only improvement report. No database or provider access."""

from __future__ import annotations

import argparse
import collections
import datetime as dt
import hashlib
import json
import math
import os
import re
import subprocess
import tempfile
from pathlib import Path

UTC = dt.UTC
BANDS = {
    "lt100": 0,
    "100_300": 100,
    "300_1000": 300,
    "1000_3000": 1000,
    "3000_10000": 3000,
    "ge10000": 10000,
}
CONTRACT = (
    Path(__file__).resolve().parents[3]
    / "packages/python/ac_platform/telemetry/lake_contracts/analytics_events.json"
)


def ratio(n, d, scale=1):
    return n / d * scale if d else None


def percentile(values, q):
    """Continuous linear interpolation; empty data is unknown, never zero."""
    values = sorted(values)
    if not values:
        return None
    position = (len(values) - 1) * q
    lo = math.floor(position)
    hi = math.ceil(position)
    return values[lo] + (values[hi] - values[lo]) * (position - lo)


def discrete(values, q):
    return sorted(values)[max(0, math.ceil(len(values) * q) - 1)] if values else None


def stamp(value):
    if isinstance(value, dt.datetime):
        return value.astimezone(UTC)
    return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(UTC)


def safe_rows(rows):
    """Validate enum dimensions before any dimension can reach reports/CLI/HQ."""
    columns = json.loads(CONTRACT.read_text())["columns"]
    for row in rows:
        for key, spec in columns.items():
            value = row.get(key)
            if value is not None and "enum" in spec and value not in spec["enum"]:
                raise ValueError("non-contract enum refused")
            if (
                value is not None
                and spec["type"] == "float64"
                and (
                    not isinstance(value, (int, float))
                    or not math.isfinite(value)
                    or not spec["min"] <= value <= spec["max"]
                )
            ):
                raise ValueError("non-contract number refused")
        yield {key: row[key] for key in columns if row.get(key) is not None}


def load_lake(root, env, start, end):
    """Only committed manifest parts; explicit missing days, no orphan glob."""
    import duckdb

    rows, coverage = [], []
    con = duckdb.connect()
    con.execute("SET memory_limit='256MB'")
    con.execute("SET threads=1")
    day = start
    while day < end:
        for table in ("analytics_events", "lead_desk_events"):
            folder = root / env / table / f"dt={day.isoformat()}"
            manifest = folder / "manifest.json"
            entry = {"day": day.isoformat(), "table": table, "available": manifest.exists()}
            coverage.append(entry)
            if manifest.exists():
                data = json.loads(manifest.read_text())
                if (
                    data.get("environment"),
                    data.get("table"),
                    data.get("day"),
                    data.get("schema"),
                ) != (env, table, day.isoformat(), "ac-lake-manifest/1"):
                    raise ValueError("manifest provenance mismatch")
                count = 0
                for part in data["parts"]:
                    path = folder / Path(part["key"]).name
                    if not path.is_file() or path.suffix != ".parquet":
                        raise ValueError("committed part missing")
                    with path.open("rb") as stream:
                        if hashlib.file_digest(stream, "sha256").hexdigest() != part["sha256"]:
                            raise ValueError("part checksum mismatch")
                    cursor = con.execute(
                        "SELECT * FROM read_parquet(?, hive_partitioning=false)", [str(path)]
                    )
                    names = [c[0] for c in cursor.description]
                    while batch := cursor.fetchmany(10000):
                        count += len(batch)
                        if table == "analytics_events":
                            rows.extend(
                                {k: v for k, v in zip(names, r, strict=True) if v is not None}
                                for r in batch
                            )
                            if len(rows) > 250000:
                                raise ValueError("bounded slice exceeded: split the input window")
                if count != data["rows"]:
                    raise ValueError("manifest row count mismatch")
                entry["rows"] = count
        day += dt.timedelta(days=1)
    con.close()
    return rows, coverage


def metrics(rows, start, end, now):
    rows = [
        r
        for r in safe_rows(rows)
        if start <= stamp(r["occurred_at"]) < end and stamp(r["retention_expires_at"]) > now
    ]
    counts = collections.Counter(r["event_name"] for r in rows)
    result = {"events": len(rows), "screen_views": counts["sx.screen_viewed"]}
    samples, band_samples = collections.defaultdict(list), collections.defaultdict(list)
    people = collections.defaultdict(set)
    for r in rows:
        screen = r.get("screen") or "other"
        key = None
        if r["event_name"] in ("sx.route_timing", "sx.action_timing") and r.get("ms") is not None:
            key = f"{r['event_name']}:{screen}:{r.get('action') or 'route'}"
            samples[key].append(r["ms"])
        if r["event_name"] in ("sx.api_timing", "sx.route_timing") and r.get("band") in BANDS:
            prefix = "api" if r["event_name"] == "sx.api_timing" else "screen_route"
            key = f"{prefix}_band_lower:{screen}"
            band_samples[key].append(BANDS[r["band"]])
        if key:
            people[key].add((r["tenant_ref"], r["subject_ref"]))
    # Suppress fine-grained measurements with fewer than three observed people.
    for groups, quantile in ((samples, percentile), (band_samples, discrete)):
        for key, values in groups.items():
            if len(people[key]) >= 3:
                result[key + ":n"] = len(values)
                for q in (50, 95, 99):
                    result[key + f":p{q}_ms"] = quantile(values, q / 100)
    api = [r for r in rows if r["event_name"] == "sx.api_timing"]
    result["api_errors_per_1000_observed_requests"] = ratio(
        sum(r.get("status") in ("4xx", "5xx", "network") for r in api), len(api), 1000
    )
    result["js_errors"] = counts["sx.js_error"]
    result["js_errors_per_1000_screen_views"] = ratio(
        counts["sx.js_error"], counts["sx.screen_viewed"], 1000
    )
    uploads = [r for r in rows if r["event_name"] == "sx.upload_finished"]
    result["failed_uploads"] = sum(
        r.get("outcome") in ("fail", "blocked", "interrupted") for r in uploads
    )
    result["upload_failures_per_1000_finishes"] = ratio(
        result["failed_uploads"], len(uploads), 1000
    )
    for kind in ("rage", "dead"):
        result[kind + "_taps"] = sum(
            r["event_name"] == "sx.tap_issue" and r.get("kind") == kind for r in rows
        )
    for flow in ("onboarding", "add_lead", "log_result", "phone_setup"):
        flow_rows = [r for r in rows if r["event_name"] == "sx.flow" and r.get("flow") == flow]
        # Explicit abandons only: a missing completion is not proof of abandonment.
        result[f"flow:{flow}:explicit_abandons"] = sum(
            r.get("outcome") == "abandon" for r in flow_rows
        )
    starts = {}
    journey_times, journey_people = collections.defaultdict(list), collections.defaultdict(set)
    for r in sorted(rows, key=lambda item: stamp(item["occurred_at"])):
        if r["event_name"] != "sx.flow" or not r.get("session_ref") or not r.get("flow"):
            continue
        key = (r["tenant_ref"], r["subject_ref"], r["session_ref"], r["flow"])
        if r.get("outcome") == "start":
            starts[key] = stamp(r["occurred_at"])
        elif r.get("outcome") == "done" and key in starts:
            duration = (stamp(r["occurred_at"]) - starts.pop(key)).total_seconds() * 1000
            journey_times[r["flow"]].append(duration)
            journey_people[r["flow"]].add((r["tenant_ref"], r["subject_ref"]))
        elif r.get("outcome") in ("abandon", "cancel", "blocked"):
            starts.pop(key, None)
    for flow, values in journey_times.items():
        if len(journey_people[flow]) >= 3:
            for q in (50, 95, 99):
                result[f"journey:{flow}:p{q}_ms"] = percentile(values, q / 100)
            result[f"journey:{flow}:n"] = len(values)
    abandon_groups = collections.defaultdict(list)
    for r in rows:
        if r["event_name"] == "sx.flow" and r.get("outcome") == "abandon":
            abandon_groups[(r.get("flow") or "unknown", r.get("step") or "unknown")].append(r)
    for (flow, step), group in abandon_groups.items():
        if len({(r["tenant_ref"], r["subject_ref"]) for r in group}) >= 3:
            result[f"abandon_point:{flow}:{step}"] = len(group)
    # 'feature_used' has no feature label in lake v1. Never infer zero-use features.
    result["feature_used_events"] = counts["sx.feature_used"]
    return result


def deltas(current, previous):
    return {
        key: {
            "before": previous.get(key),
            "after": value,
            "delta": value - previous[key]
            if value is not None and previous.get(key) is not None
            else None,
            "percent": ratio(value - previous[key], previous[key], 100)
            if value is not None and previous.get(key) is not None
            else None,
        }
        for key, value in current.items()
    }


def finding(key, tag, title, impact, confidence, effort, evidence, expected_gain):
    return dict(
        key=key,
        tag=tag,
        title=title,
        impact=impact,
        confidence=confidence,
        effort=effort,
        rank=impact * confidence / effort,
        evidence=evidence,
        expected_gain=expected_gain,
    )


def rank_findings(current, previous, env, seed=False):
    found = []
    for key, value in current.items():
        if key.endswith(":p95_ms") and value is not None and value > 1000:
            found.append(
                finding(
                    env + ":" + key,
                    "speed",
                    f"Reduce {key}",
                    value / 1000,
                    0.7,
                    2,
                    {"now_ms": value, "before_ms": previous.get(key)},
                    "Experiment: cut p95 by 20%; measure next week",
                )
            )
        if key in ("rage_taps", "dead_taps", "failed_uploads", "js_errors") and value:
            found.append(
                finding(
                    env + ":" + key,
                    "quality",
                    f"Reduce {key}",
                    value,
                    0.6,
                    2,
                    {"now_count": value, "before_count": previous.get(key)},
                    "Experiment: reduce observed failures by 20% at equal coverage",
                )
            )
    for key, value in current.items():
        if key.startswith("feature:") and key.endswith(":uses") and value == 0:
            exposures = current.get(key.removesuffix(":uses") + ":exposures")
            if exposures is not None and exposures >= 100:
                found.append(
                    finding(
                        env + ":" + key,
                        "prune",
                        "Review unused " + key.split(":")[1],
                        2,
                        0.5,
                        1,
                        {"uses": 0, "exposures": exposures},
                        (
                            "Test hiding this entry for an eligible cohort; "
                            "restore if journeys worsen. "
                            "No automatic deletion."
                        ),
                    )
                )
        if key.endswith(":change_percent") and value is not None and value >= 20:
            found.append(
                finding(
                    env + ":" + key,
                    "quality",
                    "Investigate release regression " + key,
                    value / 20,
                    0.7,
                    2,
                    {"increase_percent": value},
                    "Restore the prior release metric in a controlled experiment",
                )
            )
        if (
            key == "inr_per_analysed_minute"
            and value is not None
            and previous.get(key)
            and value > previous[key] * 1.2
        ):
            found.append(
                finding(
                    env + ":" + key,
                    "cost",
                    "Reduce ₹ per analysed call-minute",
                    value / previous[key],
                    0.8,
                    2,
                    {"now_inr": value, "before_inr": previous[key]},
                    "Test 10% lower ₹ per minute at unchanged report quality",
                )
            )
    stall = current.get("event_loop_stall_p95_ms")
    if stall is not None and stall > 100:
        found.append(
            finding(
                env + ":event-loop-stalls",
                "speed",
                "Reduce event-loop stalls",
                stall / 100,
                0.8,
                2,
                {"p95_ms": stall},
                "Target event-loop delay below 100 ms at the same concurrent load",
            )
        )
    if seed and env == "production":
        found.append(
            finding(
                "production:api-freeze-20261029",
                "speed",
                "Stop one busy event loop delaying many routes",
                25,
                0.8,
                2,
                {
                    "source": "owner seeded example 2026-10-29; not lake measurement",
                    "approx_blocked_ms": 5000,
                    "endpoints_affected": 25,
                },
                (
                    "Move blocking work off the event loop; target loop delay below 100 ms "
                    "under concurrent requests"
                ),
            )
        )
    return sorted(found, key=lambda f: (-f["rank"], f["key"]))


def supplemental(path, start, end):
    """Fixed numeric aggregate interface, exported by orchestrator; no free-text copied."""
    keys = (
        "requests",
        "errors",
        "cpu_ms",
        "spend_inr",
        "analysed_minutes",
        "active_sellers",
        "event_loop_stall_p95_ms",
        "event_loop_stalls",
        "bug_count",
        "ci_p95_ms",
    )
    if not path:
        return {}, "not supplied"
    data = json.loads(path.read_text())
    if data.get("start") != start.isoformat() or data.get("end_exclusive") != end.isoformat():
        raise ValueError("aggregate window mismatch")
    values = {k: data[k] for k in keys if k in data}
    if any(
        not isinstance(v, (float, int)) or isinstance(v, bool) or not math.isfinite(v) or v < 0
        for v in values.values()
    ):
        raise ValueError("invalid aggregate number")
    values["inr_per_analysed_minute"] = (
        ratio(values.get("spend_inr", 0), values.get("analysed_minutes", 0))
        if "spend_inr" in values
        else None
    )
    values["inr_per_active_seller"] = (
        ratio(values.get("spend_inr", 0), values.get("active_sellers", 0))
        if "spend_inr" in values
        else None
    )
    values["cpu_ms_per_request"] = (
        ratio(values.get("cpu_ms", 0), values.get("requests", 0)) if "cpu_ms" in values else None
    )
    values["server_errors_per_1000_requests"] = (
        ratio(values.get("errors", 0), values.get("requests", 0), 1000)
        if "errors" in values
        else None
    )
    for route in data.get("api_routes", []):
        name = route["route"]
        if not re.fullmatch(r"/(?:v1/)?[a-z/{}:_-]+", name):
            raise ValueError("only reviewed static API route templates accepted")
        samples = route["latency_ms"]
        if len(samples) > 250000 or any(
            not isinstance(v, (int, float)) or not math.isfinite(v) or v < 0 for v in samples
        ):
            raise ValueError("invalid route latency samples")
        for q in (50, 95, 99):
            values[f"api_route:{name}:p{q}_ms"] = percentile(samples, q / 100)
        values[f"api_route:{name}:n"] = len(samples)
    screens = json.loads(CONTRACT.read_text())["columns"]["screen"]["enum"]
    for feature in data.get("features", []):
        if feature["screen"] not in screens:
            raise ValueError("feature must use contract screen label")
        for kind in ("exposures", "uses"):
            count = feature[kind]
            if not isinstance(count, int) or count < 0:
                raise ValueError("invalid feature count")
            values[f"feature:{feature['screen']}:{kind}"] = count
    for comparison in data.get("release_comparisons", []):
        # Orchestrator supplies independently windowed aggregates per deployed release.
        if not re.fullmatch(r"v[0-9]+(?:[.][0-9]+){1,3}", comparison["release"]):
            raise ValueError("invalid release label")
        if not re.fullmatch(r"[a-z_:]+", comparison["metric"]):
            raise ValueError("invalid release metric")
        before, after = comparison["before"], comparison["after"]
        if any(
            not isinstance(v, (int, float)) or not math.isfinite(v) or v < 0
            for v in (before, after)
        ):
            raise ValueError("invalid release numbers")
        values[f"release:{comparison['release']}:{comparison['metric']}:change_percent"] = ratio(
            after - before, before, 100
        )
    return values, "orchestrator aggregate import"


def recovered(current, previous, env):
    """Close only fully measured, materially recovered speed findings, never absence."""
    result = []
    for key, value in current.items():
        before = previous.get(key)
        if (
            key.endswith(":p95_ms")
            and "band_lower" not in key
            and before is not None
            and before > 1000
            and value is not None
            and value <= 1000
            and value <= before * 0.8
        ):
            count_key = key.removesuffix(":p95_ms") + ":n"
            if min(current.get(count_key) or 0, previous.get(count_key) or 0) >= 20:
                result.append(
                    {
                        "key": env + ":" + key,
                        "before_ms": before,
                        "after_ms": value,
                        "before_n": previous[count_key],
                        "after_n": current[count_key],
                    }
                )
    return result


def ideas_step(findings):
    status = subprocess.run(
        ["/home/acdev/.local/bin/codex", "login", "status"], capture_output=True, timeout=30
    )
    if status.returncode or b"ChatGPT" not in status.stdout + status.stderr:
        raise RuntimeError("ChatGPT subscription login required; no API fallback")
    env = {
        k: v
        for k, v in os.environ.items()
        if k not in ("OPENAI_API_KEY", "ANTHROPIC_API_KEY", "CODEX_API_KEY")
    }
    fields = {
        key: {"type": "string"} for key in ("finding_key", "tag", "expected_gain", "experiment")
    }
    fields["tag"]["enum"] = ["prune", "speed", "cost", "quality"]
    schema = {
        "type": "object",
        "properties": {
            "proposals": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": fields,
                    "required": list(fields),
                    "additionalProperties": False,
                },
            }
        },
        "required": ["proposals"],
        "additionalProperties": False,
    }
    with tempfile.TemporaryDirectory(prefix="ac-improve-ideas-") as temp:
        folder = Path(temp)
        (folder / "schema.json").write_text(json.dumps(schema))
        prompt = (
            "Use only supplied aggregate findings. "
            "No tools, file reads, network, names or personal data. "
            "Propose at most one concrete experiment per finding. Preserve finding_key exactly. "
            "Expected gain is a target to test, never a measured result. Return the schema JSON.\n"
            + json.dumps(findings)
        )
        command = [
            "/home/acdev/.local/bin/codex",
            "exec",
            "-m",
            "gpt-6.1-sol",
            "--ignore-user-config",
            "--skip-git-repo-check",
            "-c",
            "features.shell_tool=false",
            "--sandbox",
            "read-only",
            "--ephemeral",
            "-C",
            temp,
            "--output-schema",
            str(folder / "schema.json"),
            "-o",
            str(folder / "ideas.json"),
            "-",
        ]
        proc = subprocess.run(  # noqa: S603 - fixed CLI and fixed flags; prompt is stdin
            command, input=prompt.encode(), env=env, capture_output=True, timeout=180
        )
        if proc.returncode:
            raise RuntimeError("subscription ideas failed or capped; no fallback")
        proposals = json.loads((folder / "ideas.json").read_text())["proposals"]
    allowed = {f["key"] for f in findings}
    result, seen = [], set()
    for item in proposals:
        key = item["finding_key"]
        if key not in allowed or key in seen or item["tag"] not in fields["tag"]["enum"]:
            raise ValueError("invalid idea linkage")
        if any(not isinstance(item[k], str) or len(item[k]) > 1500 for k in fields):
            raise ValueError("invalid idea text")
        seen.add(key)
        result.append(
            finding(
                "idea:" + key,
                item["tag"],
                item["experiment"],
                1,
                0.5,
                2,
                {"finding_key": key, "source": "subscription Codex; proposed experiment"},
                item["expected_gain"],
            )
        )
    return result


def atomic(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=path.parent)
    with os.fdopen(fd, "w") as stream:
        stream.write(value)
    os.replace(name, path)


def hq(command, op, args):
    proc = subprocess.run(  # noqa: S603 - operator-specified executable, JSON never a shell command
        [command, op, json.dumps(args)], capture_output=True, timeout=120
    )
    if proc.returncode:
        raise RuntimeError("HQ operation failed; outbox retained")
    return json.loads(proc.stdout)


def sync_hq(command, findings, state_path, improved=()):
    parents = hq(command, "find", {"marker": "orch:meet-20261028:mp16"})
    if isinstance(parents, dict):
        parents = parents.get("tasks", [])
    if len(parents) != 1:
        raise ValueError("exactly one MP16 task required")
    parent = parents[0]["id"]
    state = json.loads(state_path.read_text()) if state_path.exists() else {}
    for item in improved:
        marker = "orch:improve:" + item["key"]
        hq(command, "close", {"marker": marker, "status": "done", "note": json.dumps(item)})
    for item in findings:
        marker = "orch:improve:" + item["key"]
        notes = marker + "\n" + json.dumps(item, ensure_ascii=False)
        ensured = hq(
            command,
            "ensure",
            {
                "marker": marker,
                "fields": {"title": item["title"], "notes": notes, "priority": "normal"},
            },
        )
        task_id = ensured["id"]
        # ensure does not update existing tasks; always save parent and current evidence.
        hq(command, "save", {"id": task_id, "fields": {"parentId": parent, "notes": notes}})
        state[marker] = {"id": task_id, "parentId": parent}
        atomic(state_path, json.dumps(state, indent=2))


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--lake-dir", type=Path)
    ap.add_argument("--env", choices=["dev", "production"])
    ap.add_argument("--start", type=dt.date.fromisoformat)
    ap.add_argument("--end-exclusive", type=dt.date.fromisoformat)
    ap.add_argument("--output", type=Path, required=True)
    ap.add_argument("--aggregates", type=Path)
    ap.add_argument("--previous-aggregates", type=Path)
    ap.add_argument("--seed-api-freeze", action="store_true")
    ap.add_argument("--ideas", action="store_true")
    ap.add_argument("--sync-hq", action="store_true")
    ap.add_argument(
        "--sync-outbox",
        type=Path,
        help="apply an existing aggregate-only outbox; no lake or model read",
    )
    ap.add_argument("--hq-command", default="/usr/local/bin/ac-pulse-tasks")
    args = ap.parse_args()
    if args.sync_outbox:
        payload = json.loads(args.sync_outbox.read_text())
        sync_hq(
            args.hq_command, payload["findings"], args.output / "hq-state.json", payload["improved"]
        )
        return
    if not args.lake_dir or not args.env:
        ap.error("--lake-dir and --env are required for reporting")
    args.end_exclusive = args.end_exclusive or dt.datetime.now(UTC).date()
    args.start = args.start or args.end_exclusive - dt.timedelta(days=7)
    if not 0 < (args.end_exclusive - args.start).days <= 7:
        ap.error("window must be 1–7 days; end is exclusive")
    # Weekly baseline, same weekday/window duration, including partial first run.
    base_start, base_end = (
        args.start - dt.timedelta(days=7),
        args.end_exclusive - dt.timedelta(days=7),
    )
    rows, coverage = load_lake(args.lake_dir, args.env, args.start, args.end_exclusive)
    previous_rows, previous_coverage = load_lake(args.lake_dir, args.env, base_start, base_end)
    coverage += previous_coverage
    now = dt.datetime.now(UTC)

    def at(day):
        return dt.datetime.combine(day, dt.time(), UTC)

    current = metrics(rows, at(args.start), at(args.end_exclusive), now)
    previous = metrics(previous_rows, at(base_start), at(base_end), now)
    agg, agg_source = supplemental(args.aggregates, args.start, args.end_exclusive)
    prev_agg, _ = supplemental(args.previous_aggregates, base_start, base_end)

    def complete(start, end):
        return all(
            c["available"] for c in coverage if start.isoformat() <= c["day"] < end.isoformat()
        )

    current_ok, previous_ok = (
        complete(args.start, args.end_exclusive),
        complete(base_start, base_end),
    )
    if not current_ok:
        current = {key: None for key in current}
    if not previous_ok:
        previous = {key: None for key in previous}
    current.update(agg)
    previous.update(prev_agg)
    findings = rank_findings(current, previous, args.env, args.seed_api_freeze)
    improved = recovered(current, previous, args.env)
    report = {
        "improved": improved,
        "environment": args.env,
        "start": args.start.isoformat(),
        "end_exclusive": args.end_exclusive.isoformat(),
        "baseline_start": base_start.isoformat(),
        "coverage": coverage,
        "aggregates": agg_source,
        "current_complete": current_ok,
        "baseline_complete": previous_ok,
        "metrics": current,
        "deltas": deltas(current, previous),
        "findings": findings,
        "limitations": [
            "API bands are lower bounds, not exact ms; endpoint labels absent in lake v1.",
            "Release, feature labels, event-loop and CPU data absent in lake v1.",
            "Zero observations never authorize pruning. "
            "No people scoring or canonical state changes.",
            "Lead Desk metadata coverage checked; no content or identifiers published.",
            "Observed requests/screens are best-effort telemetry; not server traffic totals.",
        ],
    }
    out = args.output
    out.mkdir(parents=True, exist_ok=True)
    run = args.env + "-" + args.start.isoformat() + "-" + args.end_exclusive.isoformat()
    atomic(out / (run + ".json"), json.dumps(report, indent=2))
    owner = [
        f"# Weekly improvement: {args.env}",
        f"{args.start} to {args.end_exclusive} (end excluded).",
        f"Lake coverage complete: {current_ok}. Prior week complete: {previous_ok}.",
        "Missing data means unknown; it does not mean zero problems.",
    ]
    owner += [
        (
            f"- {f['title']}. Evidence: {json.dumps(f['evidence'])}. "
            f"Expected gain: {f['expected_gain']}"
        )
        for f in findings[:5]
    ]
    owner += [
        (
            f"Cost: ₹/analysed minute = {current.get('inr_per_analysed_minute', 'unknown')}; "
            f"₹/active seller = {current.get('inr_per_active_seller', 'unknown')}."
        )
    ]
    atomic(out / (run + "-owner.md"), "\n\n".join(owner) + "\n")
    atomic(
        out / (run + "-engineering.md"),
        "\n\n".join(owner) + "\n\n```json\n" + json.dumps(report, indent=2) + "\n```\n",
    )
    board_path = out / "scoreboard.json"
    board = json.loads(board_path.read_text()) if board_path.exists() else {}
    board[run] = {
        "environment": args.env,
        "start": args.start.isoformat(),
        "end_exclusive": args.end_exclusive.isoformat(),
        "complete": current_ok,
        "metrics": current,
    }
    atomic(board_path, json.dumps(board, indent=2))
    lines = [
        "# Weekly scoreboard",
        "",
        (
            "| Environment / window | Coverage | ₹ / analysed minute | "
            "₹ / active seller | CPU ms / request |"
        ),
        "|---|---|---:|---:|---:|",
    ]
    for label, entry in sorted(board.items()):

        def display(key, entry=entry):
            value = entry["metrics"].get(key)
            return "unknown" if value is None else f"{value:.3f}"

        lines.append(
            f"| {label} | {entry['complete']} | {display('inr_per_analysed_minute')} | "
            f"{display('inr_per_active_seller')} | {display('cpu_ms_per_request')} |"
        )
    atomic(out / "scoreboard.md", "\n".join(lines) + "\n")
    atomic(
        out / (run + "-hq-outbox.json"),
        json.dumps({"findings": findings, "improved": improved}, indent=2),
    )
    if args.ideas and findings:
        proposals = ideas_step(findings)
        atomic(out / (run + "-ideas.json"), json.dumps(proposals, indent=2))
        owner += [
            f"Proposed experiment: {p['title']} Expected gain: {p['expected_gain']}"
            for p in proposals
        ]
        atomic(out / (run + "-owner.md"), "\n\n".join(owner) + "\n")
        findings += proposals
        report["findings"] = findings
        atomic(out / (run + ".json"), json.dumps(report, indent=2))
        atomic(
            out / (run + "-engineering.md"),
            "\n\n".join(owner) + "\n\n```json\n" + json.dumps(report, indent=2) + "\n```\n",
        )
        atomic(
            out / (run + "-hq-outbox.json"),
            json.dumps({"findings": findings, "improved": improved}, indent=2),
        )
    if args.sync_hq:
        sync_hq(args.hq_command, findings, out / "hq-state.json", improved)
    print(
        json.dumps(
            {
                "run": run,
                "current_complete": current_ok,
                "baseline_complete": previous_ok,
                "findings": len(findings),
            }
        )
    )


if __name__ == "__main__":
    main()
