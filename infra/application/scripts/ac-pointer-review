#!/bin/bash
# Automatic AI pointer reviews for NEW Sales Xray reports only.
# Owner decision 16 Oct 2026 (rulebook 693645b0): the Report's 27 pointers and
# overall score are an AI draft. Automatic scoring never backfills: the first
# time an environment runs a release whose runner has --not-before, this script
# records that moment once (/var/lib/ac-pointer-review/<env>.since) and only
# reports finished after it are reviewed. Older calls need the manual
# per-workspace command (pointer_review_cli --tenant ...) and the owner's OK.
# Each run: at most 10 reports; per day: production 100, staging 50, dev 50
# (about Rs 1.5-2 a call on Gemini 3.8 Flash); a report that failed twice is
# not retried.
#
#   ac-pointer-review development-live | staging | production
set -euo pipefail

env_name=${1:?usage: ac-pointer-review development-live|staging|production}
module=ac_platform.conversation_intelligence.pointer_review_cli
state=/var/lib/ac-pointer-review
install -d -m 700 "$state"

case "$env_name" in
  production) cap=100 ;;
  staging | development-live) cap=50 ;;
  *) echo "unknown environment: $env_name" >&2; exit 2 ;;
esac

# The runner's help names --not-before only in releases that never backfill.
case "$env_name" in
  development-live)
    slot=$(cat /var/lib/ac-dev-live-backend/active-slot)
    python=/srv/authority-closers/development/live-backend/$slot/.venv/bin/python
    cd /tmp
    help=$(env -i PATH=/usr/bin:/bin "$python" -m "$module" --help 2>/dev/null || true)
    ;;
  staging | production)
    container=ac-application-$env_name-sales-xray-worker-1
    help=$(docker exec "$container" python -m "$module" --help 2>/dev/null || true)
    ;;
esac
grep -q -- "--not-before" <<<"$help" || exit 0

since_file=$state/$env_name.since
[ -s "$since_file" ] || date -u +%Y-%m-%dT%H:%M:%S+00:00 > "$since_file"
since=$(cat "$since_file")
common=(--recent-hours 48 --not-before "$since" --limit 10 --daily-cap "$cap" --apply)

case "$env_name" in
  development-live)
    exec env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/root LANG=C.UTF-8 PYTHONUNBUFFERED=1 \
      "$python" -m "$module" \
      --service-config /etc/authority-closers/development/service-live.json \
      --database-url-file /etc/authority-closers/development/database-url-live \
      --token-file /etc/authority-closers/development/identities/gemini/token \
      --infisical /usr/local/bin/infisical \
      --state-file "$state/development-live.json" \
      "${common[@]}"
    ;;
  staging | production)
    exec docker exec "$container" python -m "$module" \
      --service-config /run/ac-sales-xray/service.json \
      --database-url-file /run/ac-sales-xray/database-url \
      --state-file "/srv/authority-closers/sales-xray/$env_name/scratch/pointer-review-failures.json" \
      "${common[@]}"
    ;;
esac
