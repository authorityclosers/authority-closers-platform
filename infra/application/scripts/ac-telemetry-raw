#!/usr/bin/python3 -I
"""Ship closed analytics journals using ac-archive-put's Infisical credential seam."""

from __future__ import annotations

import base64
import fcntl
import gzip
import hashlib
import json
import os
import re
import runpy
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

BUCKET = "ac-archive-283923228069-apse2"
REGION = "ap-southeast-2"
HELPER = "/usr/local/sbin/ac-archive-put"
ROOT = Path("/var/lib/ac-telemetry")


def run(argv: list[str], env: dict[str, str]) -> str:
    result = subprocess.run(  # noqa: S603 - fixed AWS argv, no shell
        argv,
        env=env,
        capture_output=True,
        text=True,  # noqa: S603
        check=False,
        timeout=1200,
    )
    if result.returncode:
        raise RuntimeError("raw archive upload or verification failed")
    return result.stdout


def checksum(path: Path) -> bytes:
    with path.open("rb") as handle:
        return hashlib.file_digest(handle, "sha256").digest()


def upload(path: Path, key: str, env: dict[str, str]) -> None:
    digest = base64.b64encode(checksum(path)).decode()
    run(
        [
            "/usr/local/bin/aws",
            "s3api",
            "put-object",
            "--bucket",
            BUCKET,
            "--key",
            key,
            "--body",
            str(path),
            "--server-side-encryption",
            "AES256",
            "--checksum-algorithm",
            "SHA256",
            "--checksum-sha256",
            digest,
            "--content-type",
            "application/x-ndjson",
            "--content-encoding",
            "gzip",
        ],
        env,
    )
    metadata = json.loads(
        run(
            [
                "/usr/local/bin/aws",
                "s3api",
                "head-object",
                "--bucket",
                BUCKET,
                "--key",
                key,
                "--checksum-mode",
                "ENABLED",
                "--output",
                "json",
            ],
            env,
        )
    )
    if (
        metadata.get("ContentLength") != path.stat().st_size
        or metadata.get("ChecksumSHA256") != digest
        or metadata.get("ServerSideEncryption") != "AES256"
    ):
        raise RuntimeError("raw archive verification failed")


def atomic_json(path: Path, record: dict) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    fd = os.open(temporary, os.O_CREAT | os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(record, handle, sort_keys=True)
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)
    fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def ship(root: Path, environment: str, env: dict[str, str], *, now: datetime | None = None) -> int:
    now = now or datetime.now(UTC)
    hour = now.strftime("%Y-%m-%dT%H")
    count = 0
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Same lock as intake: rename only closed hours; a second shipper cannot race deletion.
    with (root / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for path in root.glob("*.open"):
            if not path.name.startswith(hour + "-"):
                fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
                try:
                    end = os.lseek(fd, 0, os.SEEK_END)
                    if end and os.pread(fd, 1, end - 1) != b"\n":
                        tail = os.pread(fd, min(end, 1024 * 1024), max(0, end - 1024 * 1024))
                        newline = tail.rfind(b"\n")
                        end = max(0, end - len(tail)) + newline + 1 if newline >= 0 else 0
                        os.ftruncate(fd, end)
                        os.fsync(fd)
                finally:
                    os.close(fd)
                path.rename(path.with_suffix(".ndjson"))
    with (root / ".ship-lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for path in sorted(root.glob("*.ndjson")):
            if not re.fullmatch(r"\d{4}-\d{2}-\d{2}T\d{2}-[A-Za-z0-9-]+\.ndjson", path.name):
                raise ValueError("invalid raw journal name")
            if path.is_symlink():
                raise ValueError("unsafe raw journal")
            days: dict[str, set[str]] = {}
            with path.open() as handle:
                for line in handle:
                    for event in json.loads(line)["events"]:
                        days.setdefault(event["occurred_at"][:10], set()).add(
                            f"{event['tenant_id']}:{event['event_id']}"
                        )
            compressed = path.with_suffix(".ndjson.gz")
            # Stream compression; never buffer a full hour in RAM.
            fd = os.open(compressed, os.O_CREAT | os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            with path.open("rb") as source, os.fdopen(fd, "wb") as destination:
                with gzip.GzipFile(fileobj=destination, mode="wb", mtime=0) as zipped:
                    while block := source.read(1024 * 1024):
                        zipped.write(block)
                destination.flush()
                os.fsync(destination.fileno())
            day, hour_host_seq = path.name.split("T", 1)
            key = f"lake/raw/{environment}/analytics/dt={day}/{hour_host_seq}.gz"
            upload(compressed, key, env)
            # Kept bounded provenance inventory allows reconciliation after deletion.
            atomic_json(
                path.with_suffix(".receipt"),
                {
                    "key": key,
                    "verified_at": now.isoformat(),
                    "bytes": compressed.stat().st_size,
                    "sha256": checksum(compressed).hex(),
                    "days": {day: sorted(ids) for day, ids in days.items()},
                },
            )
            # Only a verified object and fsynced receipt authorize local removal.
            path.unlink()
            compressed.unlink()
            count += 1
        # Local receipt IDs are needed only beyond the seven-day intake replay window.
        for receipt in root.glob("*.receipt"):
            verified = datetime.fromisoformat(json.loads(receipt.read_text())["verified_at"])
            if (now - verified).total_seconds() >= 10 * 86400:
                receipt.unlink()
        atomic_json(root / "shipper.json", {"ok": True, "time": now.isoformat(), "files": count})
    return count


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in {"dev", "production", "staging", "development-live"}:
        return 2
    environment = "dev" if argv[0] == "development-live" else argv[0]
    parent = (
        ROOT
        if environment != "dev"
        else Path("/srv/authority-closers/sales-xray/development-live/telemetry")
    )
    root = parent / environment
    try:
        values = runpy.run_path(HELPER)["credentials"]()
        if values["AC_ARCHIVE_BUCKET"] != BUCKET or values["AC_ARCHIVE_REGION"] != REGION:
            raise ValueError("archive target mismatch")
        env = {
            "PATH": "/usr/local/bin:/usr/bin:/bin",
            "HOME": "/root",
            "AWS_ACCESS_KEY_ID": values["AC_ARCHIVE_AWS_ACCESS_KEY_ID"],
            "AWS_SECRET_ACCESS_KEY": values["AC_ARCHIVE_AWS_SECRET_ACCESS_KEY"],
            "AWS_DEFAULT_REGION": REGION,
            "AWS_EC2_METADATA_DISABLED": "true",
            "AWS_CONFIG_FILE": "/dev/null",
            "AWS_SHARED_CREDENTIALS_FILE": "/dev/null",
            "AWS_PAGER": "",
        }
        print(json.dumps({"environment": environment, "files": ship(root, environment, env)}))
        return 0
    except Exception:
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        atomic_json(root / "shipper.json", {"ok": False, "time": datetime.now(UTC).isoformat()})
        print("raw archive failed; local journal retained", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
