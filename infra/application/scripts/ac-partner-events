#!/bin/bash
# Partner webhooks runner: Sales X-Ray -> partner (first Wise Life), contract
# sx.analysis_completed.v1 (18 Oct 2026).
# Every minute (ac-partner-events@<env>.timer), for about 55 seconds: quote
# facts for new reports of workspaces with an active endpoint (one Gemini 3.8
# Flash call per report, at most two attempts, daily cap below), one frozen
# signed event per report, delivery with retries (10 s doubling to 1 h, 25
# attempts, then dead letter), and emptying the payloads of erased calls.
# Nothing is backfilled: only reports finished after an endpoint was
# registered are sent. With no active endpoint it only runs the erasure sweep
# and stops before fetching any secret.
# Endpoints are registered by hand (python -m ac_platform.partner_events.cli
# register-endpoint ..., dry run unless --apply, audited).
#
#   ac-partner-events development-live | staging | production
set -euo pipefail

env_name=${1:?usage: ac-partner-events development-live|staging|production}
module=ac_platform.partner_events.cli

case "$env_name" in
  production) cap=300 ;;
  staging | development-live) cap=100 ;;
  *) echo "unknown environment: $env_name" >&2; exit 2 ;;
esac

# A release without the runner does nothing.
case "$env_name" in
  development-live)
    slot=$(cat /var/lib/ac-dev-live-backend/active-slot)
    python=/srv/authority-closers/development/live-backend/$slot/.venv/bin/python
    cd /tmp
    help=$(env -i PATH=/usr/bin:/bin "$python" -m "$module" --help 2>/dev/null || true)
    ;;
  staging | production)
    container=ac-application-$env_name-sales-xray-worker-1
    help=$(docker exec "$container" python -m "$module" --help 2>/dev/null || true)
    ;;
esac
grep -q -- "register-endpoint" <<<"$help" || exit 0

run=(run --apply --seconds 55 --interval 5 --daily-cap "$cap")

case "$env_name" in
  development-live)
    exec env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/root LANG=C.UTF-8 PYTHONUNBUFFERED=1 \
      "$python" -m "$module" \
      --service-config /etc/authority-closers/development/service-live.json \
      --database-url-file /etc/authority-closers/development/database-url-live \
      --token-file /etc/authority-closers/development/identities/gemini/token \
      --infisical /usr/local/bin/infisical \
      "${run[@]}"
    ;;
  staging | production)
    exec docker exec "$container" python -m "$module" \
      --service-config /run/ac-sales-xray/service.json \
      --database-url-file /run/ac-sales-xray/database-url \
      "${run[@]}"
    ;;
esac
