#!/usr/bin/env python3
"""Copy committed lake manifests and exactly their listed parts into the
improvement engine's private lake folder (orchestrator, 29 Oct 2026).

Read-only on S3. Credentials come from the archive helper's Infisical reader,
never from arguments or the caller's environment. Files are left readable by
the engine's group (acdev) and nobody else.

usage: ac-improve-fetch <env> [<first-day> <last-day>]
Without days it fetches the 15 full UTC days before today: the engine's
current week plus its baseline week.
"""

from __future__ import annotations

import datetime
import grp
import hashlib
import json
import os
import pathlib
import runpy
import subprocess
import sys

BUCKET = "ac-archive-283923228069-apse2"
REGION = "ap-southeast-2"
ENVIRONMENTS = ("dev", "staging", "production")
TABLES = ("analytics_events", "lead_desk_events")
DEST = pathlib.Path("/var/lib/ac-improve/lake")
READER_GROUP = "acdev"
DEFAULT_DAYS = 15


def aws_env() -> dict[str, str]:
    values = runpy.run_path("/usr/local/sbin/ac-archive-put")["credentials"]()
    if values["AC_ARCHIVE_BUCKET"] != BUCKET or values["AC_ARCHIVE_REGION"] != REGION:
        raise ValueError("archive target mismatch")
    return {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "HOME": "/root",
        "AWS_ACCESS_KEY_ID": values["AC_ARCHIVE_AWS_ACCESS_KEY_ID"],
        "AWS_SECRET_ACCESS_KEY": values["AC_ARCHIVE_AWS_SECRET_ACCESS_KEY"],
        "AWS_DEFAULT_REGION": REGION,
        "AWS_EC2_METADATA_DISABLED": "true",
        "AWS_CONFIG_FILE": "/dev/null",
        "AWS_SHARED_CREDENTIALS_FILE": "/dev/null",
        "AWS_PAGER": "",
    }


def get(key: str, target: pathlib.Path, env: dict[str, str]) -> bool:
    result = subprocess.run(  # noqa: S603 - fixed argv, no shell or inherited environment
        [
            "/usr/local/bin/aws",
            "s3api",
            "get-object",
            "--bucket",
            BUCKET,
            "--key",
            key,
            str(target),
        ],
        env=env,
        capture_output=True,
        text=True,
        timeout=600,
        check=False,
        cwd="/",
    )
    return result.returncode == 0


def listing(environment: str, env: dict[str, str]) -> dict[str, str]:
    """One list call per run: each committed manifest's key and ETag.

    The service runs at a quarter of a CPU, so one AWS call per day and table
    was too slow; days without a manifest are known from this list instead.
    """
    result = subprocess.run(  # noqa: S603 - fixed argv, no shell or inherited environment
        [
            "/usr/local/bin/aws",
            "s3api",
            "list-objects-v2",
            "--bucket",
            BUCKET,
            "--prefix",
            f"lake/{environment}/",
            "--query",
            "Contents[?ends_with(Key, 'manifest.json')].[Key, ETag]",
            "--output",
            "json",
        ],
        env=env,
        capture_output=True,
        text=True,
        timeout=600,
        check=False,
        cwd="/",
    )
    if result.returncode != 0:
        raise RuntimeError("lake listing failed")
    return {key: etag.strip('"') for key, etag in json.loads(result.stdout) or []}


def window(argv: list[str], today: datetime.date) -> tuple[str, datetime.date, datetime.date]:
    if len(argv) not in (1, 3) or argv[0] not in ENVIRONMENTS:
        raise SystemExit("usage: ac-improve-fetch dev|staging|production [<first-day> <last-day>]")
    if len(argv) == 3:
        first, last = datetime.date.fromisoformat(argv[1]), datetime.date.fromisoformat(argv[2])
    else:
        first, last = (
            today - datetime.timedelta(days=DEFAULT_DAYS),
            today - datetime.timedelta(days=1),
        )
    if first > last or (last - first).days >= 62:
        raise SystemExit("ac-improve-fetch: the window must be 1 to 62 days")
    return argv[0], first, last


def sha256(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def share(path: pathlib.Path, gid: int | None) -> None:
    if gid is not None:
        os.chown(path, 0, gid)
    path.chmod(0o750 if path.is_dir() else 0o640)


def fetch_day(
    environment: str,
    table: str,
    day: datetime.date,
    manifests: dict[str, str],
    env: dict[str, str],
    gid: int | None,
) -> dict:
    prefix = f"lake/{environment}/{table}/dt={day}/"
    folder = DEST / environment / table / f"dt={day}"
    folder.mkdir(parents=True, exist_ok=True)
    for path in (folder.parents[1], folder.parent, folder):
        share(path, gid)
    manifest_path = folder / "manifest.json"
    key = prefix + "manifest.json"
    if key not in manifests:
        # Not committed yet: the engine treats a missing manifest as unknown, never zero.
        manifest_path.unlink(missing_ok=True)
        return {"table": table, "day": str(day), "manifest": "missing"}
    # A single-part upload's ETag is its MD5: an unchanged local copy needs no download.
    same = (
        manifest_path.is_file()
        and manifests[key]
        == hashlib.md5(manifest_path.read_bytes(), usedforsecurity=False).hexdigest()
    )
    if not same and not get(key, manifest_path, env):
        raise RuntimeError(f"download failed: {key}")
    manifest = json.loads(manifest_path.read_text())
    if (
        manifest["environment"] != environment
        or manifest["table"] != table
        or manifest["day"] != str(day)
    ):
        raise ValueError(f"lake manifest mismatch: {prefix}")
    for part in manifest["parts"]:
        name = part["key"].removeprefix(prefix)
        if not part["key"].startswith(prefix) or "/" in name or not name.endswith(".parquet"):
            raise ValueError(f"invalid lake part path: {part['key']}")
        local = folder / name
        if not (local.is_file() and sha256(local) == part["sha256"]):
            if not get(part["key"], local, env):
                raise RuntimeError(f"download failed: {part['key']}")
            if sha256(local) != part["sha256"]:
                raise ValueError(f"checksum mismatch: {part['key']}")
        share(local, gid)
    share(manifest_path, gid)
    return {
        "table": table,
        "day": str(day),
        "rows": manifest["rows"],
        "parts": len(manifest["parts"]),
    }


def main(argv: list[str]) -> int:
    environment, day, last = window(argv, datetime.datetime.now(datetime.UTC).date())
    env = aws_env()
    os.umask(0o027)
    DEST.mkdir(parents=True, exist_ok=True)
    gid = grp.getgrnam(READER_GROUP).gr_gid if os.geteuid() == 0 else None
    manifests = listing(environment, env)
    days = []
    while day <= last:
        days.extend(fetch_day(environment, table, day, manifests, env, gid) for table in TABLES)
        day += datetime.timedelta(days=1)
    print(json.dumps({"environment": environment, "days": days}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
