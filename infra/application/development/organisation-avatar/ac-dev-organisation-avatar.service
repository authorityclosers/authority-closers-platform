[Unit]
Description=Private development organisation logo scanner
Requires=docker.service
After=docker.service network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose -f /etc/authority-closers/development/organisation-avatar/compose.yaml up -d --wait --wait-timeout 360
ExecStartPost=/usr/bin/python3 /etc/authority-closers/development/organisation-avatar/prove.py
ExecStop=/usr/bin/docker compose -f /etc/authority-closers/development/organisation-avatar/compose.yaml stop
TimeoutStartSec=8min
TimeoutStopSec=60
MemoryMax=128M
CPUQuota=25%
TasksMax=64
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
