# Sales X-Ray usage metrics collector (19 Oct 2026). Read-only exports into the metrics store.
[Unit]
Description=Collect Sales X-Ray usage metrics into the separate metrics store (read-only)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Export every environment to the read-only metrics store mounted by production Admin.
Environment="AC_METRICS_ENVIRONMENTS=development staging production"
ExecStart=/usr/local/sbin/ac-metrics-collect
# AI budget alerts from the fresh export: owner's AC Pulse task, one Telegram line,
# a Telegram line per ceiling or period change. Production only unless set (19 Oct 2026).
ExecStartPost=-/usr/local/sbin/ac-budget-alerts --apply
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
TimeoutStartSec=5min
