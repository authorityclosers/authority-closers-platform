# Sales X-Ray usage metrics collector (19 Oct 2026). Read-only exports into the metrics store.
[Unit]
Description=Collect Sales X-Ray usage metrics into the separate metrics store (read-only)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Which environments this host exports. Production joins when its Admin mounts the store.
Environment="AC_METRICS_ENVIRONMENTS=development staging"
ExecStart=/usr/local/sbin/ac-metrics-collect
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
TimeoutStartSec=5min
