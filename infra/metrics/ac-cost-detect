# A currency mark not inside a word ("orders 12" is no money), then the figure.
_MONEY = re.compile(
    r"(?<![A-Za-z])(?P<cur>₹|INR|Rs\.?|US\$|USD|\$|EUR|€)\s?"
    r"(?P<num>\d{1,3}(?:,\d{2,3})*(?:\.\d{1,2})?|\d+(?:\.\d{1,2})?)",
    re.IGNORECASE,
)
_TOTAL = re.compile(r"total|amount (?:paid|charged|due)|you paid|charged|grand", re.IGNORECASE)
# Mail about money that is not a charge (first run, 30 Oct 2026: a welcome mail with free
# credits, a credit note and a budget alert were proposed beside the one real receipt).
_NOT_A_CHARGE = re.compile(
    r"\b(welcome|free (?:plan|tier|trial)|trial|credit note|refund|budget|alert"
    r"|payment (?:failed|declined|unsuccessful)|action required|reminder|upcoming|will renew"
    r"|updates? to your|upgraded|congrats|congratulations)\b"
    # A reply in a thread, or a bracketed notification ("[org/repo] …", "[Task Update] …").
    r"|^\s*(?:re:|\[)",
    re.IGNORECASE,
)
# Payment processors send a seller's receipt under their own address; the seller is in the
# subject ("Your receipt from Eleven Labs Inc. #2274-0126-4953").
PROCESSORS = ("stripe.com", "paddle.com", "paddle.net", "fastspring.com", "lemonsqueezy.com")
_SELLER = re.compile(
    r"(?:receipt|invoice) from ([A-Za-z0-9][A-Za-z0-9 .&'-]{1,40}?)(?:,|\s+#|\s+for\s|\s*$)",
    re.IGNORECASE,
)
_SUFFIX = re.compile(r"[\s,]+(?:inc|llc|ltd|pbc|gmbh|limited|pvt)\.?$", re.IGNORECASE)


def _plain(name: str) -> str:
    return re.sub(r"[^a-z0-9]", "", name.lower())


_CODES = {
    "₹": "INR",
    "inr": "INR",
    "rs": "INR",
    "rs.": "INR",
    "us$": "USD",
    "usd": "USD",
    "$": "USD",
    "eur": "EUR",
    "€": "EUR",
}


def amounts(text: str) -> list[tuple[str, float, bool]]:
    """(currency, amount, near a total word) for each money figure in the text."""
    found = []
    for match in _MONEY.finditer(text):
        currency = _CODES[match.group("cur").lower()]
        value = float(match.group("num").replace(",", ""))
        context = text[max(0, match.start() - 40) : match.start()]
        found.append((currency, value, bool(_TOTAL.search(context))))
    return found


def pick(figures: list[tuple[str, float, bool]]) -> tuple[str, float] | None:
    """The charge: the largest figure near a total word, else the largest; rupees first."""
    if not figures:
        return None
    totals = [item for item in figures if item[2]] or figures
    rupee = [item for item in totals if item[0] == "INR"]
    currency, value, _ = max(rupee or totals, key=lambda item: item[1])
    return currency, value


def vendor_for(sender: str, subject: str) -> tuple[tuple[str, str, str, str, dict, str], str]:
    """(the vendor row, confidence) for a sender's domain and the subject."""
    domain = parseaddr(sender)[1].rpartition("@")[2].lower()
    if domain == "google.com" or domain.endswith(".google.com"):
        lowered = subject.lower()
        for word, row in GOOGLE:
            if word in lowered:
                return row, "high"
        return GOOGLE[2][1], "low"
    if any(domain == known or domain.endswith("." + known) for known in PROCESSORS):
        seller = _SELLER.search(subject)
        if seller:
            name = _SUFFIX.sub("", seller.group(1).strip()).strip()
            for row in VENDORS.values():
                if _plain(row[0]) == _plain(name):
                    return row, "high"
            return (
                name,
                "Charge",
                "other",
                "company",
                {"rule": "direct", "product": "company"},
                "monthly",
            ), "low"
    for known, row in VENDORS.items():
        if domain == known or domain.endswith("." + known):
            return row, "high"
    name = (domain.split(".")[-2] if "." in domain else domain or "Unknown").capitalize()
    return (
        name,
        "Charge",
        "other",
        "company",
        {"rule": "direct", "product": "company"},
        "monthly",
    ), "low"


_FORWARD = re.compile(r"\s*(?:fwd?|fw):", re.IGNORECASE)
# The original sender inside a forwarded message ("From: Vendor <billing@vendor.example>").
_FORWARDED_FROM = re.compile(r"From:\s*[^<\n]*?<?([\w.+-]+@[\w-]+(?:\.[\w-]+)+)>?", re.IGNORECASE)


def propose(
    mailbox: str, message: dict, *, billing: bool = False, extra_text: str = ""
) -> dict | None:
    """One proposed cost from a Gmail message (format=full), or None when it holds no charge.

    ``billing``: the message reached the billing inbox, so it is filed whatever it says (no
    filter, our own forwards included), with "amount to check" when no amount is found.
    ``extra_text``: the text of its PDF attachments."""
    headers = {h["name"].lower(): h["value"] for h in message["payload"].get("headers", [])}
    subject = headers.get("subject", "")[:200]
    forwarded = bool(_FORWARD.match(subject))
    if not billing:
        if _NOT_A_CHARGE.search(subject):
            return None
        # Our own mail (to a vendor's support, say) is no charge; a forwarded invoice is.
        sender_domain = parseaddr(headers.get("from", ""))[1].rpartition("@")[2].lower()
        own = sender_domain == mailbox.rpartition("@")[2].lower()
        if own and not forwarded:
            return None
    body = body_text(message["payload"])
    text = " ".join([subject, message.get("snippet", ""), body, extra_text])
    charge = pick(amounts(text))
    if charge is not None and charge[1] <= 0:
        charge = None
    if charge is None and not billing:
        return None
    sender = headers.get("from", "")
    if forwarded:
        original = _FORWARDED_FROM.search(body)
        if original:
            sender = original.group(1)
    (vendor, item, category, centre, split, cadence), confidence = vendor_for(sender, subject)
    currency, value = charge if charge is not None else ("INR", None)
    try:
        day = parsedate_to_datetime(headers["date"]).date().isoformat()
    except (KeyError, TypeError, ValueError):
        day = (
            datetime.fromtimestamp(int(message.get("internalDate", 0)) / 1000, UTC)
            .date()
            .isoformat()
        )
    marker = "cost:" + hashlib.sha256(f"{mailbox}\0{message['id']}".encode()).hexdigest()[:16]
    return {
        "marker": marker,
        "vendor": vendor,
        "item": item,
        "currency": currency,
        "amount": value,
        "rupees": None if value is None else round(value * RATES[currency], 2),
        "converted": currency != "INR",
        "cadence": cadence,
        "category": category,
        "centre": centre,
        "split": split,
        "confidence": confidence,
        "date": day,
        "subject": subject,
        "mailbox": mailbox,
        "gmail_id": message["id"],
    }


def body_text(payload: dict, limit: int = 50_000) -> str:
    """The message's plain text (HTML stripped when there is no text part), at most ``limit``."""
    plain: list[str] = []
    markup: list[str] = []

    def walk(part: dict) -> None:
        data = (part.get("body") or {}).get("data")
        mime = part.get("mimeType", "")
        if data and mime in ("text/plain", "text/html"):
            raw = base64.urlsafe_b64decode(data + "=" * (-len(data) % 4)).decode("utf-8", "replace")
            (plain if mime == "text/plain" else markup).append(raw)
        for child in part.get("parts") or []:
            walk(child)

    walk(payload)
    if plain:
        return " ".join(plain)[:limit]
    stripped = re.sub(r"<(script|style)[^>]*>.*?</\1>", " ", " ".join(markup), flags=re.S | re.I)
    return re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", " ", stripped)))[:limit]


def task(proposal: dict) -> dict:
    """The ensure op for one proposal: title and notes, never the email's body."""
    if proposal["amount"] is None:
        original = "amount to check (see the email and its attachment)"
    elif proposal["converted"]:
        original = (
            f"{proposal['currency']} {proposal['amount']:,.2f} (about ₹{proposal['rupees']:,.2f})"
        )
    else:
        original = f"₹{proposal['amount']:,.2f}"
    split = proposal["split"]
    split_words = split["rule"] + (
        f" {split.get('product') or split.get('tool') or ''}".rstrip() if len(split) > 1 else ""
    )
    title = (
        f"Cost to check: {proposal['vendor']} ({proposal['date']})"
        if proposal["amount"] is None
        else f"Cost found: {proposal['vendor']} {original} ({proposal['date']})"
    )[:200]
    where = f"{proposal['mailbox']}, {proposal['date']}, “{proposal['subject']}”"
    notes = "\n".join(
        [
            "Proposed from email. Confirm it into AC Pulse finance and Admin → Economics →"
            " cost register.",
            f"Vendor: {proposal['vendor']} · {proposal['item']}",
            f"Amount: {original}",
            f"Repeats: {proposal['cadence']}",
            f"Category: {proposal['category']} · cost centre: {proposal['centre']}",
            f"Split: {split_words}",
            f"Confidence: {proposal['confidence']}",
            f"Email: {where}, Gmail id {proposal['gmail_id']}",
            f"Marker: {proposal['marker']}",
        ]
    )
    return {
        "op": "ensure",
        "marker": proposal["marker"],
        "fields": {"title": title, "notes": notes},
        "parent": {"title": PARENT, "fields": {"title": PARENT}},
    }


def assertion(key: dict, mailbox: str, now: int) -> str:
    """A signed JWT asking Google for a read-only Gmail token for ``mailbox`` (RS256)."""
    from cryptography.hazmat.primitives import hashes, serialization
    from cryptography.hazmat.primitives.asymmetric import padding

    def b64(data: bytes) -> str:
        return base64.urlsafe_b64encode(data).rstrip(b"=").decode()

    header = b64(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    claims = b64(
        json.dumps(
            {
                "iss": key["client_email"],
                "sub": mailbox,
                "scope": SCOPE,
                "aud": key.get("token_uri", "https://oauth2.googleapis.com/token"),
                "iat": now,
                "exp": now + 3600,
            }
        ).encode()
    )
    signer = serialization.load_pem_private_key(key["private_key"].encode(), password=None)
    signature = signer.sign(f"{header}.{claims}".encode(), padding.PKCS1v15(), hashes.SHA256())
    return f"{header}.{claims}.{b64(signature)}"


def _http(url: str, *, data: bytes | None = None, token: str | None = None) -> dict:
    request = urllib.request.Request(url, data=data)  # noqa: S310 - fixed Google hosts
    if token:
        request.add_header("Authorization", f"Bearer {token}")
    with urllib.request.urlopen(request, timeout=30) as response:  # noqa: S310
        return json.loads(response.read())


class Gmail:
    """Read-only Gmail for one mailbox through the delegated service account."""

    def __init__(self, key: dict, mailbox: str, http: Callable[..., dict] = _http) -> None:
        self.http = http
        token = http(
            key.get("token_uri", "https://oauth2.googleapis.com/token"),
            data=urllib.parse.urlencode(
                {
                    "grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer",
                    "assertion": assertion(key, mailbox, int(time.time())),
                }
            ).encode(),
        )
        self.token = token["access_token"]

    def search(self, days: int, query: str = QUERY) -> list[str]:
        q = urllib.parse.urlencode({"q": f"newer_than:{days}d {query}", "maxResults": 100})
        found = self.http(f"{GMAIL}/messages?{q}", token=self.token)
        return [row["id"] for row in found.get("messages", [])]

    def message(self, message_id: str) -> dict:
        return self.http(
            f"{GMAIL}/messages/{urllib.parse.quote(message_id)}?format=full", token=self.token
        )

    def pdfs(self, message: dict) -> list[bytes]:
        """The message's PDF attachments (at most 3, each up to 10 MB)."""
        found: list[bytes] = []

        def walk(part: dict) -> None:
            body = part.get("body") or {}
            is_pdf = part.get("mimeType") == "application/pdf" or str(
                part.get("filename", "")
            ).lower().endswith(".pdf")
            small = body.get("size", 0) <= PDF_LIMIT
            if is_pdf and body.get("attachmentId") and small and len(found) < 3:
                data = self.http(
                    f"{GMAIL}/messages/{urllib.parse.quote(message['id'])}/attachments/"
                    f"{urllib.parse.quote(body['attachmentId'])}",
                    token=self.token,
                )["data"]
                found.append(base64.urlsafe_b64decode(data + "=" * (-len(data) % 4)))
            for child in part.get("parts") or []:
                walk(child)

        walk(message["payload"])
        return found


def pdf_text(blob: bytes) -> str:
    """A PDF's text through pdftotext (poppler-utils), first 3 pages; empty when it can't."""
    with tempfile.TemporaryDirectory(prefix="ac-cost-detect-") as folder:
        path = Path(folder) / "invoice.pdf"
        path.write_bytes(blob)
        try:
            done = subprocess.run(  # noqa: S603 - fixed argv
                [PDFTOTEXT, "-l", "3", "-layout", str(path), "-"],
                capture_output=True,
                timeout=30,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            return ""
    return done.stdout.decode("utf-8", "replace")[:50_000] if done.returncode == 0 else ""


def pulse(op: dict, *, dry: bool) -> dict:
    request = {"actor": "ac-cost-detect", "dry": dry, "ops": [op]}
    done = subprocess.run(  # noqa: S603 - fixed argv
        [PULSE, "--batch", "-"],
        input=json.dumps(request, ensure_ascii=False),
        capture_output=True,
        text=True,
        timeout=120,
        check=False,
    )
    if done.returncode != 0:
        raise RuntimeError(f"ac-pulse-tasks refused (exit {done.returncode})")
    return json.loads(done.stdout)


def run(
    mailboxes: list[str],
    open_mailbox: Callable[[str], Gmail],
    file: Callable[[dict], object],
    seen: list[str],
    *,
    days: int,
    billing: str = "",
) -> tuple[list[dict], list[str]]:
    """(the proposals filed, the seen hashes after the run). One charge described by several
    emails (a receipt and an invoice, two mailboxes) is filed once: vendor, amount and day.
    ``billing``: only the mail that reached that inbox, every message filed (PDFs read when
    the body names no amount)."""
    known = set(seen)
    filed: list[dict] = []
    for mailbox in mailboxes:
        gmail = open_mailbox(mailbox)
        found = (
            gmail.search(days, f"(to:{billing} OR deliveredto:{billing} OR cc:{billing})")
            if billing
            else gmail.search(days)
        )
        for message_id in found:
            digest = hashlib.sha256(f"{mailbox}\0{message_id}".encode()).hexdigest()[:24]
            if digest in known:
                continue
            message = gmail.message(message_id)
            proposal = propose(mailbox, message, billing=bool(billing))
            if billing and proposal is not None and proposal["amount"] is None:
                extra = " ".join(pdf_text(blob) for blob in gmail.pdfs(message))
                if extra.strip():
                    proposal = propose(mailbox, message, billing=True, extra_text=extra)
            if proposal is not None:
                # A charge is its vendor, amount and day; one with no amount is its message.
                charge = (
                    "c:"
                    + hashlib.sha256(
                        f"{proposal['vendor']}\0{proposal['currency']}\0{proposal['amount']}"
                        f"\0{proposal['date']}".encode()
                    ).hexdigest()[:22]
                    if proposal["amount"] is not None
                    else "c:" + digest
                )
                if charge not in known:
                    file(task(proposal))
                    filed.append(proposal)
                    known.add(charge)
                    seen.append(charge)
            known.add(digest)
            seen.append(digest)
    return filed, seen[-SEEN_LIMIT:]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--days", type=int, default=3)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument(
        "--mark-seen",
        action="store_true",
        help="remember these days' mail without filing (costs already in the register)",
    )
    parser.add_argument(
        "--billing",
        action="store_true",
        help="only the mail that reached the billing inbox (AC_COST_DETECT_BILLING), all filed",
    )
    args = parser.parse_args(argv)
    if not 1 <= args.days <= 60:
        parser.error("--days is 1 to 60")
    if args.billing and not BILLING:
        parser.error("--billing needs AC_COST_DETECT_BILLING")
    if not KEY.exists():
        print("ac-cost-detect: no service-account key yet; nothing read")
        return 0
    key = json.loads(KEY.read_text(encoding="utf-8"))
    # The daily run and the 15-minute billing run share the state: one at a time.
    STATE.parent.mkdir(parents=True, exist_ok=True)
    lock = STATE.with_suffix(".lock").open("w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        seen = json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        seen = []
    if args.mark_seen:
        file: Callable[[dict], object] = lambda op: None  # noqa: E731
    elif args.dry_run:
        file = lambda op: print(json.dumps(op, ensure_ascii=False))  # noqa: E731
    else:
        file = lambda op: pulse(op, dry=False)  # noqa: E731
    filed, seen = run(
        MAILBOXES,
        lambda mailbox: Gmail(key, mailbox),
        file,
        list(seen),
        days=args.days,
        billing=BILLING if args.billing else "",
    )
    if not args.dry_run:
        STATE.write_text(json.dumps(seen), encoding="utf-8")
    lock.close()
    print(
        json.dumps(
            {
                "filed": 0 if args.mark_seen else len(filed),
                "marked_seen": len(filed) if args.mark_seen else 0,
                "mailboxes": len(MAILBOXES),
            }
        )
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
