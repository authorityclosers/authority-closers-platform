#!/usr/bin/env python3
"""AI budget alerts for the owner (orchestrator, 19 Oct 2026: never stuck in production).

Reads the usage metrics store (filled read-only by ac-metrics-collect) and:
- keeps one AC Pulse task for the owner per environment while its AI budget is at or
  above 80% used, or any call is waiting for budget. The task names the level and links
  the one-click raise in Admin. It moves to done once usage is back under 80% and nothing
  waits. Pulse is written only through pulse.task_save / pulse.task_move, like
  ac-pulse-gold-bridge;
- sends the owner one Telegram line when an alert opens or gets worse, never repeats;
- sends the owner one Telegram line for each change of the ceiling or the period in Admin
  (owner decision via the orchestrator, 19 Oct 2026), through the AC channel.

Monthly and daily budgets count what is spent this month or today (India time) against
the cap per period; the export does that sum.

Task text carries amounts and links only, never call content.

  ac-budget-alerts            dry run: print the plan
  ac-budget-alerts --apply    apply it (ac-metrics-collect runs this after each export)
  ac-budget-alerts --selftest create and close a fake alert in Pulse, rolled back

Environments: AC_BUDGET_ALERT_ENVIRONMENTS (space separated, default "production").
"""

from __future__ import annotations

import datetime as dt
import json
import os
import pathlib
import subprocess
import sys

STORE = pathlib.Path(os.environ.get("AC_METRICS_STORE", "/srv/authority-closers/metrics"))
KIT = "/srv/authority-closers/pulse/kit"
PULSE_ENV = "/etc/pulse/pulse.env"
STATE = pathlib.Path("/var/lib/ac-budget-alerts/state.json")
LOG = pathlib.Path("/var/log/ac-budget-alerts.log")
NOTIFY = "/usr/local/sbin/ac-notify-owner"
ACTOR = "ac-budget-alerts (Sales X-Ray AI budget, owner order 19 Oct 2026)"
ADMIN = {
    "production": "https://admin.authorityclosers.com",
    "staging": "https://admin-staging.authorityclosers.com",
    "development": "https://admin-dev.authorityclosers.com",
}
NAME = {"production": "production", "staging": "staging", "development": "dev"}
PER = {"monthly": "a month", "daily": "a day", "lifetime": "in total"}
OF = {"monthly": "this month's ", "daily": "today's ", "lifetime": "the "}
# Worse first: an alert moves to the worst level that applies.
LEVELS = ("waiting", "out", "90", "80")

CONTEXT = """
begin;
set local role pulse_owner;
select org_id as org from pulse.install limit 1 \\gset
select set_config('pulse.org_id', :'org', true) \\g /dev/null
select person_id as me from pulse.people_profile
 where org_id = :'org' and username = 'suyash' \\gset
select set_config('pulse.viewer_id', :'me', true) \\g /dev/null
select set_config('pulse.actor_account', :'actor', true) \\g /dev/null
"""

APPLY_SQL = """
select 'created', count(pulse.task_save(null, jsonb_build_object(
         'title', s->>'title', 'assigneeId', :'me', 'priority', 'high',
         'category', pulse.work_category_guess(s->>'title'), 'tags', '[]'::jsonb,
         'notes', s->>'notes')))
  from jsonb_array_elements(:'plan'::jsonb->'create') s
 where not exists (select 1 from pulse.task t
                    where t.deleted_at is null and t.status not in ('done', 'cancelled')
                      and position(s->>'marker' in coalesce(t.notes, '')) > 0);
select 'closed', count(pulse.task_move(t.id, 'done', d->>'note'))
  from jsonb_array_elements(:'plan'::jsonb->'move') d
  join pulse.task t on t.deleted_at is null and position(d->>'marker' in coalesce(t.notes, '')) > 0
 where t.status not in ('done', 'cancelled');
"""


def log(line: str) -> None:
    stamp = dt.datetime.now(dt.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    with LOG.open("a", encoding="utf-8") as handle:
        handle.write(f"{stamp} {line}\n")


def rupees(paise: int) -> str:
    return f"₹{paise / 100:,.0f}"


def level_of(used: float, waiting: int) -> str | None:
    if waiting:
        return "waiting"
    if used >= 1:
        return "out"
    if used >= 0.9:
        return "90"
    if used >= 0.8:
        return "80"
    return None


def read_env(env: str) -> dict | None:
    path = STORE / env / "usage.json"
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    budgets = [row for row in document.get("budgets", []) if isinstance(row, dict)]
    cap = sum(int(row.get("cap_paise") or 0) for row in budgets)
    used = sum(int(row.get("committed_paise") or 0) for row in budgets)
    periods = {row.get("period") or "lifetime" for row in budgets}
    return {
        "cap": cap,
        "used": used,
        "share": used / cap if cap else (1.0 if budgets else 0.0),
        "waiting": int(document.get("waiting_calls") or 0),
        "period": periods.pop() if len(periods) == 1 else "lifetime",
        "changes": [row for row in document.get("budget_changes", []) if isinstance(row, dict)],
        "generated_at": document.get("generated_at"),
    }


def alert_text(env: str, level: str, figures: dict) -> tuple[str, str, str]:
    """(Pulse title, Pulse notes, Telegram line) for one environment's alert."""

    name, share = NAME[env], round(figures["share"] * 100)
    link = f"{ADMIN[env]}/sales-xray/execution"
    if level == "waiting":
        headline = f"{figures['waiting']} Sales X-Ray calls are waiting for AI budget ({name})"
    elif level == "out":
        headline = f"Sales X-Ray AI budget is used up ({name})"
    else:
        headline = f"Sales X-Ray AI budget {share}% used ({name})"
    period = figures.get("period", "lifetime")
    notes = (
        f"{rupees(figures['used'])} of {OF.get(period, 'the ')}{rupees(figures['cap'])} cap "
        "is spent or held.\n"
        f"Raise it in one click: {link} (+₹1,000, +₹2,500 or +₹5,000, up to the ceiling).\n"
        "Calls waiting for budget continue by themselves within a minute of a raise.\n"
        "This task closes itself once usage is back under 80% and no call is waiting.\n"
        f"marker: ac-budget-alerts/{env}/{level}"
    )
    return headline, notes, f"{headline}. Raise it: {link}"


def plan_alerts(state: dict, figures_by_env: dict[str, dict]) -> tuple[dict, list[str], dict]:
    plan: dict[str, list] = {"create": [], "move": []}
    lines: list[str] = []
    alerts = dict(state.get("alerts", {}))
    for env, figures in figures_by_env.items():
        level = level_of(figures["share"], figures["waiting"])
        current = alerts.get(env)
        if level == current:
            continue
        if current is not None:
            plan["move"].append(
                {
                    "marker": f"ac-budget-alerts/{env}/{current}",
                    "note": "Back under 80% with no call waiting."
                    if level is None
                    else "Replaced by a newer budget alert.",
                }
            )
        if level is not None:
            title, notes, line = alert_text(env, level, figures)
            plan["create"].append(
                {"marker": f"ac-budget-alerts/{env}/{level}", "title": title, "notes": notes}
            )
            worse = current is None or LEVELS.index(level) < LEVELS.index(current)
            if worse:
                lines.append(line)
            alerts[env] = level
        else:
            alerts.pop(env, None)
    return plan, lines, alerts


def pulse_psql(sql: str, variables: dict[str, str]) -> str:
    args = [
        "docker",
        "compose",
        "--env-file",
        PULSE_ENV,
        "exec",
        "-T",
        "postgres",
        "psql",
        "-U",
        "pulse_admin",
        "-d",
        "pulse",
        "-At",
        "-F",
        "\t",
        "-v",
        "ON_ERROR_STOP=1",
    ]
    for key, value in variables.items():
        args += ["-v", f"{key}={value}"]
    # Fixed argument list, no shell; the SQL goes in on stdin.
    out = subprocess.run(  # noqa: S603
        args, cwd=KIT, input=sql, capture_output=True, text=True, check=False
    )
    if out.returncode:
        raise SystemExit(f"pulse psql failed: {out.stderr.strip()[:400]}")
    return out.stdout


def apply_pulse(plan: dict, *, commit: bool) -> str:
    sql = CONTEXT + APPLY_SQL + ("commit;\n" if commit else "rollback;\n")
    return pulse_psql(sql, {"actor": ACTOR, "plan": json.dumps(plan, ensure_ascii=False)})


def change_line(env: str, change: dict) -> str | None:
    """One Telegram line for a change of the ceiling or the period; None for a cap raise."""

    before, after = change.get("before_ceiling_paise"), change.get("ceiling_paise")
    period = change.get("period") or "lifetime"
    if before == after and change.get("before_period") == period:
        return None
    cap = change.get("cap_paise")
    now = f"{rupees(int(cap))} {PER.get(period, 'in total')}" if cap is not None else period
    if before != after and after is not None:
        was = rupees(int(before)) if before is not None else "the release amount"
        head = f"Sales X-Ray AI budget ceiling changed ({NAME[env]}): {was} → {rupees(int(after))}"
    else:
        head = f"Sales X-Ray AI budget period changed ({NAME[env]})"
    return f"{head}; cap {now}. {ADMIN[env]}/sales-xray/execution"


def main() -> None:
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "--selftest":
        figures = {"cap": 1_000_000, "used": 950_000, "share": 0.95, "waiting": 0}
        title, notes, _ = alert_text("production", "90", figures)
        plan = {
            "create": [
                {
                    "marker": "ac-budget-alerts/selftest/90",
                    "title": title,
                    "notes": notes.replace("production/90", "selftest/90"),
                }
            ],
            "move": [{"marker": "ac-budget-alerts/selftest/90", "note": "selftest"}],
        }
        print(apply_pulse(plan, commit=False).strip())
        print("rolled back")
        return
    envs = os.environ.get("AC_BUDGET_ALERT_ENVIRONMENTS", "production").split()
    figures_by_env = {env: f for env in envs if env in ADMIN and (f := read_env(env)) is not None}
    STATE.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    state = json.loads(STATE.read_text()) if STATE.exists() else {}
    plan, lines, alerts = plan_alerts(state, figures_by_env)
    known = set(state.get("changes", []))
    changes = [
        (str(change.get("id")), line)
        for env, f in figures_by_env.items()
        for change in f["changes"]
        if str(change.get("id")) not in known
        if (line := change_line(env, change)) is not None
    ]
    seen = [str(change.get("id")) for f in figures_by_env.values() for change in f["changes"]]
    summary = {
        env: {"used": f"{round(f['share'] * 100)}%", "waiting": f["waiting"]}
        for env, f in figures_by_env.items()
    }
    print(
        json.dumps(
            {
                "environments": summary,
                "pulse": {k: len(v) for k, v in plan.items()},
                "telegram": lines + [line for _, line in changes],
            },
            ensure_ascii=False,
        )
    )
    if mode != "--apply":
        if plan["create"] or plan["move"] or changes:
            print("Dry run only. Add --apply.")
        return
    if plan["create"] or plan["move"]:
        out = apply_pulse(plan, commit=True)
        log(f"pulse {out.strip()!r}")
    for line in lines + [line for _, line in changes]:
        subprocess.run([NOTIFY, line], check=False, capture_output=True)  # noqa: S603
        log(f"telegram {line!r}")
    # Every change seen counts as handled, cap raises too, so none is sent twice.
    handled = list(dict.fromkeys([*known, *seen]))
    STATE.write_text(json.dumps({"alerts": alerts, "changes": handled[-200:]}, indent=1))


if __name__ == "__main__":
    main()
