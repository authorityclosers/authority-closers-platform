	# Canonical production DNS may exist before the first application release.
	# Keep those new hosts explicitly unavailable instead of falling through to
	# the generic foundation page or to a missing application upstream.
	@production_unreleased host learner.authorityclosers.com admin.authorityclosers.com coach.authorityclosers.com api.authorityclosers.com
	handle @production_unreleased {
		import base_security_headers
		header X-Authority-Closers-Route "release-hold-production"
		header Cache-Control "no-store"
		header Retry-After "30"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		respond "Production application release is not active.\n" 503
	}

	@learner host app.authorityclosers.com
	@learner_api {
		host app.authorityclosers.com
		path /v1/*
	}
	handle @learner_api {
		import base_security_headers
		header X-Authority-Closers-Route "api-production"
		header Cache-Control "no-store"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		reverse_proxy ac-production-api:8000
	}
	handle @learner {
		import base_security_headers
		header X-Authority-Closers-Route "learner-production"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
		reverse_proxy ac-production-learner:3000
	}
