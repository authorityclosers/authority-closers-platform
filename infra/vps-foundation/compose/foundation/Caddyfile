{
  admin off
  auto_https off
  persist_config off
}

:8080 {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    Cache-Control "no-store"
  }

  @health path /healthz
  respond @health `{\"status\":\"ok\",\"service\":\"authority-closers-foundation\"}` 200
  respond "Authority Closers infrastructure foundation is online.\n" 200

  log {
    output stdout
    format json
  }
}
