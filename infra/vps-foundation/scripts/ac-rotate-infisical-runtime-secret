#!/usr/bin/env bash
set -euo pipefail

bootstrap='/etc/authority-closers/secrets/infisical-bootstrap.env'
incoming='/tmp/ac-vps-runtime-secret.new'
tmp="$(mktemp)"
trap 'rm -f "$tmp" "$incoming"' EXIT

test -s "$incoming"
python3 - "$bootstrap" "$incoming" "$tmp" <<'PY'
from pathlib import Path
import sys

bootstrap, incoming, target = map(Path, sys.argv[1:])
secret = incoming.read_text(encoding="utf-8").strip()
if len(secret) < 20 or "\n" in secret or "\r" in secret:
    raise SystemExit("incoming client secret failed validation")

lines = bootstrap.read_text(encoding="utf-8").splitlines()
updated = False
out = []
for line in lines:
    if line.startswith("INFISICAL_VPS_CLIENT_SECRET="):
        out.append("INFISICAL_VPS_CLIENT_SECRET=" + secret)
        updated = True
    else:
        out.append(line)
if not updated:
    raise SystemExit("bootstrap file has no runtime client secret entry")
target.write_text("\n".join(out) + "\n", encoding="utf-8")
PY

install -o root -g root -m 600 "$tmp" "$bootstrap"
echo 'PASS rotated Infisical runtime client secret without printing its value.'
