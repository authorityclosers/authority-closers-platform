#!/usr/bin/env bash
set -euo pipefail

: "${RESEND_API_KEY:?RESEND_API_KEY is required}"

response_file="$(mktemp -t ac-resend-domains.XXXXXX.json)"
detail_file="$(mktemp -t ac-resend-domain.XXXXXX.json)"
cleanup() { rm -f -- "$response_file" "$detail_file"; }
trap cleanup EXIT

curl --fail-with-body --silent --show-error --max-time 20 \
  -H "Authorization: Bearer $RESEND_API_KEY" \
  -o "$response_file" \
  https://api.resend.com/domains

domain_id="$(jq -r '.data[] | select(.name == "authorityclosers.com") | .id' "$response_file")"
[[ -n "$domain_id" && "$domain_id" != "null" ]] || { printf 'authorityclosers.com is not present in Resend.\n'; exit 1; }
curl --fail-with-body --silent --show-error --max-time 20 \
  -H "Authorization: Bearer $RESEND_API_KEY" \
  -o "$detail_file" \
  "https://api.resend.com/domains/$domain_id"
jq '.' "$detail_file"
