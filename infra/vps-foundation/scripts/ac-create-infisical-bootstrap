#!/usr/bin/env bash
set -euo pipefail

test_mode="${AC_TEST_MODE:-0}"
[[ "$test_mode" == 0 || "$test_mode" == 1 ]] || { printf 'AC_TEST_MODE must be 0 or 1.\n' >&2; exit 2; }
if [[ "$test_mode" == 1 ]]; then
  source_file="${AC_PRODUCTION_ENV_SOURCE:-}"
  target_file="${AC_INFISICAL_BOOTSTRAP_TARGET:-}"
  [[ "$source_file" == /* && "$target_file" == /* && "$source_file" != "$target_file" ]] || {
    printf 'Test mode requires distinct absolute source and target paths.\n' >&2
    exit 2
  }
else
  [[ "$(id -u)" -eq 0 ]] || { printf 'Run as root.\n' >&2; exit 1; }
  source_file='/etc/authority-closers/secrets/production.env'
  target_file='/etc/authority-closers/secrets/infisical-bootstrap.env'
fi
[[ -r "$source_file" ]] || { printf 'Recovery export is not readable: %s\n' "$source_file" >&2; exit 1; }

umask 077
install -d -m 0700 "$(dirname "$target_file")"
tmp_file="$(mktemp "$(dirname "$target_file")/.infisical-bootstrap.XXXXXX")"
cleanup() { rm -f -- "$tmp_file"; }
trap cleanup EXIT

python3 - "$source_file" "$tmp_file" <<'PY'
from __future__ import annotations

import os
import shlex
import sys
from pathlib import Path

source = Path(sys.argv[1])
target = Path(sys.argv[2])
required = (
    "INFISICAL_VPS_CLIENT_ID",
    "INFISICAL_VPS_CLIENT_SECRET",
    "INFISICAL_BACKUP_CLIENT_ID",
    "INFISICAL_BACKUP_CLIENT_SECRET",
)
values: dict[str, str] = {}
for line_number, line in enumerate(source.read_text(encoding="utf-8").splitlines(), start=1):
    if not line or line.lstrip().startswith("#") or "=" not in line:
        continue
    key, raw_value = line.split("=", 1)
    if key not in required:
        continue
    if key in values:
        raise SystemExit(f"duplicate bootstrap key on line {line_number}: {key}")
    value = raw_value
    if value[:1] in {"'", '"'}:
        try:
            parsed = shlex.split(value, comments=False, posix=True)
        except ValueError as error:
            raise SystemExit(f"invalid quoted dotenv value for {key}: {error}") from error
        if len(parsed) != 1:
            raise SystemExit(f"quoted dotenv value for {key} must decode to one value")
        value = parsed[0]
    values[key] = value

missing = [key for key in required if key not in values]
if missing:
    raise SystemExit("missing bootstrap keys: " + ", ".join(missing))

with target.open("w", encoding="utf-8", newline="\n") as output:
    output.write("INFISICAL_PROJECT_ID=" + shlex.quote("b421c44e-4599-4394-8df6-758ed8aedfed") + "\n")
    for key in required:
        output.write(f"{key}={shlex.quote(values[key])}\n")
    output.flush()
    os.fsync(output.fileno())
PY

chmod 600 "$tmp_file"
if [[ "$test_mode" == 1 ]]; then
  install -m 600 "$tmp_file" "$target_file"
else
  chown root:root "$tmp_file"
  install -o root -g root -m 600 "$tmp_file" "$target_file"
fi
printf 'PASS  Identity-only Infisical bootstrap installed at %s.\n' "$target_file"
