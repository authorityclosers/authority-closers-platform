#!/usr/bin/env bash
set -euo pipefail

: "${R2_ENDPOINT:?R2_ENDPOINT is required}"
: "${R2_ACCESS_KEY_ID:?R2_ACCESS_KEY_ID is required}"
: "${R2_SECRET_ACCESS_KEY:?R2_SECRET_ACCESS_KEY is required}"
: "${R2_BACKUP_BUCKET:?R2_BACKUP_BUCKET is required}"
: "${RESTIC_PASSWORD:?RESTIC_PASSWORD is required}"

export AWS_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY"
export RESTIC_REPOSITORY="${RESTIC_REPOSITORY:-s3:${R2_ENDPOINT#https://}/${R2_BACKUP_BUCKET}}"
export RESTIC_CACHE_DIR='/var/cache/authority-closers-restic'

# Refuse silent uncached operation before any repository request.
cache_unavailable() {
  printf 'AC_BACKUP_FAILURE=restic_cache_unavailable\n' >&2
  [[ -z "${AC_RESTIC_CACHE_FAILURE_FILE:-}" ]] || : > "$AC_RESTIC_CACHE_FAILURE_FILE"
  return 1
}
if [[ ! -d "$RESTIC_CACHE_DIR" || -L "$RESTIC_CACHE_DIR" ]] ||
   [[ "$(stat --format='%u' -- "$RESTIC_CACHE_DIR")" != 0 ]] ||
   ! cache_probe="$(mktemp "$RESTIC_CACHE_DIR/.probe.XXXXXX")"; then
  cache_unavailable; exit 1
fi
rm -- "$cache_probe"
AC_RESTIC_BINARY="$(command -v restic)"
export AC_RESTIC_BINARY
# shellcheck disable=SC2329  # Invoked by the inline wrapper generated with declare -f.
restic() {
  local diagnostics status=0
  diagnostics="$("$AC_RESTIC_BINARY" "$@" 2>&1 1>&3)" || status=$?
  if [[ "$diagnostics" == *'unable to open cache'* ]]; then
    cache_unavailable; return 1
  fi
  [[ -z "$diagnostics" ]] || printf '%s\n' "$diagnostics" >&2
  return "$status"
} 3>&1
# Cache admission complete.

restic_lock_dir='/run/lock/authority-closers'
restic_lock_file="$restic_lock_dir/ac-restic-repository.lock"
((EUID == 0)) || { printf 'Restic repository locking requires root.\n' >&2; exit 1; }
if mkdir --mode=0750 -- "$restic_lock_dir" 2>/dev/null; then
  chown root:acops "$restic_lock_dir"
fi
acops_gid="$(getent group acops | awk -F: 'NR == 1 {print $3}')"
[[ "$acops_gid" =~ ^[0-9]+$ ]] || { printf 'The acops group is unavailable.\n' >&2; exit 1; }
[[ -d "$restic_lock_dir" && ! -L "$restic_lock_dir" ]] || {
  printf 'The private Restic lock directory is unsafe.\n' >&2
  exit 1
}
[[ "$(stat --format='%u:%g:%a' -- "$restic_lock_dir")" == "0:$acops_gid:750" ]] || {
  printf 'The private Restic lock directory has an unsafe identity.\n' >&2
  exit 1
}
if [[ -e "$restic_lock_file" || -L "$restic_lock_file" ]]; then
  [[ -f "$restic_lock_file" && ! -L "$restic_lock_file" ]] || {
    printf 'The private Restic lock file is unsafe.\n' >&2
    exit 1
  }
fi
exec 9>>"$restic_lock_file"
chmod 0640 "$restic_lock_file"
chown root:acops "$restic_lock_file"
[[ "$(stat --dereference --format='%u:%g:%a:%h' -- /proc/self/fd/9)" == "0:$acops_gid:640:1" ]] || {
  printf 'The private Restic lock descriptor is unsafe.\n' >&2
  exit 1
}
# Wait only for local contention; invalid descriptors/configuration fail closed.
restic_lock_wait_seconds=600
if flock --exclusive --timeout "$restic_lock_wait_seconds" --conflict-exit-code 75 9 2>/dev/null; then
  :
else
  restic_lock_status=$?
  if ((restic_lock_status == 75)); then
    printf 'Restic repository lock wait timed out after %s seconds.\n' "$restic_lock_wait_seconds" >&2
  else
    printf 'Restic repository lock acquisition failed safely.\n' >&2
  fi
  exit "$restic_lock_status"
fi
# Repository lock acquired.

# Python suppresses child stderr; an inline temporary wrapper preserves the
# cache failure classification without changing the proof's restore logic.
cache_wrapper="$(mktemp -d "$RESTIC_CACHE_DIR/.wrapper.XXXXXX")" || { cache_unavailable; exit 1; }
trap 'rm -rf -- "$cache_wrapper"' EXIT
export AC_RESTIC_CACHE_FAILURE_FILE="$cache_wrapper/failed"
{ printf '#!/usr/bin/env bash\n'; declare -f cache_unavailable restic; printf 'restic "$@"\n'; } > "$cache_wrapper/restic"
chmod 0700 "$cache_wrapper/restic"
export PATH="$cache_wrapper:$PATH"
proof_status=0
/usr/local/libexec/authority-closers/ac-restic-postgres-restore-proof.py "$@" || proof_status=$?
[[ ! -e "$AC_RESTIC_CACHE_FAILURE_FILE" ]] || { cache_unavailable; exit 1; }
exit "$proof_status"
