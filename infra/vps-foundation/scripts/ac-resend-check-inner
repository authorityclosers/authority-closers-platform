#!/usr/bin/env bash
set -euo pipefail

: "${RESEND_API_KEY:?RESEND_API_KEY is required}"

response_file="$(mktemp -t ac-resend-domains.XXXXXX.json)"
cleanup() { rm -f -- "$response_file"; }
trap cleanup EXIT

curl --fail-with-body --silent --show-error --max-time 20 \
  -H "Authorization: Bearer $RESEND_API_KEY" \
  -o "$response_file" \
  https://api.resend.com/domains

jq -r 'if (.data | type) == "array" then (.data[] | [.name, .status] | @tsv) else "no-domain-data" end' "$response_file"
printf 'PASS  Resend API authentication succeeded.\n'
