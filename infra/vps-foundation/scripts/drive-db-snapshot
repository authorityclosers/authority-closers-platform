#!/usr/bin/env bash
# Candidate only. Dry-run by default; explicit --execute is required for capture.
# Reuse canonical exported-snapshot capture/counts through the bounded Drive helper.
set -euo pipefail
snapshot_environment="${1:?usage: ac-db-snapshot <staging|production> [label] [--execute]}"
shift
case "$snapshot_environment" in staging|production) ;; *) printf 'invalid environment\n' >&2; exit 2 ;; esac
snapshot_label=manual
if [[ $# -gt 0 && "$1" != --* ]]; then
  snapshot_label="$1"
  shift
fi
helper=/usr/local/libexec/authority-closers/drive_postgres_backup.py
if [[ $# == 1 && "$1" == --execute ]]; then
  exec /usr/local/sbin/ac-infisical-run-backup -- python3 "$helper" capture \
    --environment "$snapshot_environment" --label "$snapshot_label" --execute
elif [[ $# == 0 ]]; then
  exec python3 "$helper" capture --environment "$snapshot_environment" --label "$snapshot_label"
else
  printf 'only --execute is accepted\n' >&2
  exit 2
fi
