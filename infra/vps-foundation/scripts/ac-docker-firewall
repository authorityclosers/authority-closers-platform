#!/usr/bin/env bash
set -euo pipefail

external_interface="${AC_EXTERNAL_INTERFACE:-eth0}"

ip link show dev "$external_interface" >/dev/null 2>&1 || {
  printf 'External interface does not exist: %s\n' "$external_interface" >&2
  exit 1
}

install_rule() {
  local binary="$1"
  shift
  if ! "$binary" -C DOCKER-USER "$@" 2>/dev/null; then
    "$binary" -I DOCKER-USER 1 "$@"
  fi
}

for binary in iptables ip6tables; do
  command -v "$binary" >/dev/null 2>&1 || {
    printf 'Required firewall binary is unavailable: %s\n' "$binary" >&2
    exit 1
  }
  "$binary" -nL DOCKER-USER >/dev/null 2>&1 || {
    printf '%s DOCKER-USER chain is unavailable; refusing an unguarded Docker runtime.\n' "$binary" >&2
    exit 1
  }

  install_rule "$binary" -i "$external_interface" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  if ! "$binary" -C DOCKER-USER -i "$external_interface" -j DROP 2>/dev/null; then
    "$binary" -A DOCKER-USER -i "$external_interface" -j DROP
  fi

  "$binary" -C DOCKER-USER -i "$external_interface" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  "$binary" -C DOCKER-USER -i "$external_interface" -j DROP
done
