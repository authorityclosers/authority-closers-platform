# Copy to a root-readable environment file only after R2 is activated and a
# backup-specific scoped key plus an independently escrowed password exist.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/authority-closers-backups-prod
RESTIC_PASSWORD_FILE=/etc/authority-closers/secrets/restic-password
AWS_ACCESS_KEY_ID=replace-with-scoped-backup-key
AWS_SECRET_ACCESS_KEY=replace-with-scoped-backup-secret
