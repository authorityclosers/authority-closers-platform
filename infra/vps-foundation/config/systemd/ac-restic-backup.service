[Unit]
Description=Authority Closers encrypted off-host Restic backup
After=network-online.target ac-r2-usage-guard.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ac-restic-backup
User=root
Group=root
Environment=AC_IPV4_ONLY=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_UNIX
ReadOnlyPaths=/etc/authority-closers/secrets/infisical-bootstrap.env /srv/authority-closers /etc/ssh /etc/systemd/system /etc/fail2ban /usr/local/sbin /var/lib/docker/volumes
ReadWritePaths=/var/cache/authority-closers-restic
