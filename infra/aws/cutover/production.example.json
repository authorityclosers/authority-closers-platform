      "-o",
      "BatchMode=yes",
      "-i",
      "/etc/authority-closers/secrets/aws-cutover-ssh",
      "ubuntu@3.25.123.75",
      "sudo -n python3 /usr/local/lib/ac-cutover/endpoint.py database --permit-production-restore ac-application-production-postgres-1 ac_platform"
    ],
    "manifest": [
