[Unit]
Description=AWS production backup %i
After=docker.service network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/python3 /usr/local/lib/ac-cutover/backup.py %i --config /etc/authority-closers/aws-backup.json
TimeoutStartSec=16min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/authority-closers/backups/aws /run/lock
