#!/usr/bin/env python3
"""EA server: AC's Play tester contacts become relationship contacts (owner correction 23 Oct 2026, AUT-2210).

Owner: "these are not just testers, in fact they are good contacts: some are business owners, some are employees, but
yes they do have a tag of tester for salesxray app for now". Through Pulse's own API at pulse.authorityclosers.com, as
the owner, on a short-lived organisation-switch session that is signed out at the end:
1. contact type "Relationship contact" (made if missing): Business role (Unknown / Business owner / Employee),
   Company, Tags, Introduced by;
2. every contact of type play_tester moves to it, with Business role "Unknown" unless the source list said
   (its group "EA team" means Employee), Tags "Sales X-Ray Play tester", Introduced by "Dipak" where the list said so.
   The AC shared Google account is a device, not a person: it moves to "Other";
3. the "Play tester" type is archived (nothing has it any more).
Contacts keep their id, name, e-mail, phone and history. Prints counts only.
"""
from __future__ import annotations

import hashlib
import json
import secrets
import subprocess
import sys
import urllib.error
import urllib.request

ORG = "350ce338-d796-4de2-b17b-07cbc337f27a"
HOST = "pulse.authorityclosers.com"
BASE = "http://127.0.0.1:4002"
DEVICE = "Claude · relationship contacts (AUT-2210)"
PSQL = ["docker", "exec", "-i", "ea-postgres", "psql", "-U", "ea_admin", "-d", "pulse", "-X", "-q", "-A", "-t", "-v", "ON_ERROR_STOP=1"]
TYPE = {"label": "Relationship contact", "plural": "Relationship contacts", "color": "indigo",
        "hint": "People we know: business owners, employees and others; tags say what they are part of",
        "fields": [{"key": "business_role", "label": "Business role", "type": "choice", "options": ["Unknown", "Business owner", "Employee"]},
                   {"key": "company", "label": "Company", "type": "text"},
                   {"key": "tags", "label": "Tags", "type": "text"},
                   {"key": "introduced_by", "label": "Introduced by", "type": "text"}]}
TESTER_TAG = "Sales X-Ray Play tester"


def psql(sql: str) -> str:
    out = subprocess.run(PSQL, input=sql, capture_output=True, text=True, check=False)
    if out.returncode:
        raise SystemExit(f"psql: {out.stderr.strip()[-300:]}")
    return out.stdout.strip()


class Api:
    def __init__(self, token: str) -> None:
        self.cookie = f"pulse_session={token}"

    def call(self, method: str, path: str, body: object | None = None) -> object:
        req = urllib.request.Request(BASE + path, data=json.dumps(body).encode() if body is not None else None, method=method,
                                     headers={"Host": HOST, "X-Forwarded-Proto": "https", "X-Forwarded-Host": HOST,
                                              "Origin": f"https://{HOST}", "Referer": f"https://{HOST}/contacts",
                                              "Cookie": self.cookie, "Content-Type": "application/json",
                                              "Accept": "application/json", "User-Agent": "ac-pulse-contacts-retype"})
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                return json.loads(r.read() or b"null")
        except urllib.error.HTTPError as e:
            raise RuntimeError(f"{method} {path}: HTTP {e.code} {e.read()[:300].decode(errors='replace')}") from None


def main() -> int:
    token = secrets.token_urlsafe(32)
    digest = hashlib.sha256(token.encode()).hexdigest()
    if psql(f"select pulse.acct_session((select id from pulse_priv.pulse_account where handle = 'suyash'), '{ORG}', "
            f"'{digest}', '{DEVICE}')::text;") in ("", "null"):
        raise SystemExit("no session")
    api = Api(token)
    try:
        types = api.call("GET", "/api/v0/types")["contact"]  # type: ignore[index]
        rel = next((t for t in types if t["label"].lower() == TYPE["label"].lower()), None)
        if not rel:
            rel = api.call("POST", "/api/v0/settings/types", {"entity": "contact", "key": "", **TYPE})
            print("type created:", rel["key"])  # type: ignore[index]
        rel_key = rel["key"]  # type: ignore[index]
        contacts = api.call("GET", "/api/v0/contacts")["contacts"]  # type: ignore[index]
        moved = {"relationship": 0, "other": 0}
        roles: dict[str, int] = {}
        for c in [c for c in contacts if c["contactType"] == "play_tester"]:
            # The detail API has no custom values: read the old group (a read only; every write is the API's).
            group = psql(f"select coalesce(custom->>'group', '') from pulse.contact_profile where org_id = '{ORG}' "
                         f"and person_id = '{c['id']}';")
            notes = ""
            # The tester-only fields go first, while the type still has them (their values stay in the history).
            api.call("POST", f"/api/v0/contacts/{c['id']}", {f"custom.{k}": "" for k in
                     ("group", "stage", "app_version", "working", "feedback", "asked_on", "play_list")})
            if group == "AC device":
                body = {"contactType": "other",
                        "notes": "AC's shared Google account on the Redmi 13 5G (a device, not a person). Tags: " + TESTER_TAG + "."}
                moved["other"] += 1
            else:
                role = "Employee" if group == "EA team" else "Unknown"
                roles[role] = roles.get(role, 0) + 1
                body = {"contactType": rel_key, "custom.business_role": role, "custom.tags": TESTER_TAG,
                        "custom.introduced_by": "Dipak" if "via Dipak" in group or "via Dipak" in notes else "",
                        "notes": "Relationship contact. Tagged " + TESTER_TAG + " (Internal testing, invited 23 Oct 2026)."}
                moved["relationship"] += 1
            api.call("POST", f"/api/v0/contacts/{c['id']}", body)
        print(json.dumps({"moved": moved, "business_role": roles}))
        left = [c for c in api.call("GET", "/api/v0/contacts")["contacts"] if c["contactType"] == "play_tester"]  # type: ignore[index]
        if not left:
            api.call("POST", "/api/v0/settings/types", {"entity": "contact", "key": "play_tester", "archived": True})
            print("Play tester type archived")
        else:
            print("Play tester type kept:", len(left), "contacts still have it")
    finally:
        try:
            api.call("POST", "/api/v0/auth/sign-out", {})
        except RuntimeError as e:
            print("sign-out through the app failed:", e, "- using Pulse's own logout instead")
            psql(f"select set_config('pulse.org_id', '{ORG}', false) \\g /dev/null\n"
                 f"select pulse.auth_logout('staff', '{digest}');")
        left = psql(f"select count(*) from pulse.login_session where org_id = '{ORG}' and token_hash = '{digest}' "
                    "and revoked_at is null and expires_at > now();")
        print("session signed out" if left == "0" else f"WARNING: session still open ({left})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
