#!/usr/bin/env python3
"""AC server: rotate the four login-role passwords of AC's own Pulse database without printing any of them.

Owner approval 23 Oct 2026 (AUT-2207: "freeze AC's install and rotate its DB passwords"): the API, worker, ingest and
privacy login-role passwords were printed into a session transcript on 23 Oct. Each role gets a new random password.
The database receives only its SCRAM-SHA-256 verifier (never the password, so no server log can hold it), in one
read-write transaction. /etc/pulse/pulse.env and /etc/pulse/secrets/role-passwords.env get the new values in place
(same owner and mode, a root-only backup of each file first). Nothing secret is printed: only role names and counts.

  python3 rotate-db-passwords.py            # dry run: which roles, how many places each password appears
  python3 rotate-db-passwords.py --apply
"""
from __future__ import annotations

import base64
import hashlib
import hmac
import os
import secrets
import shutil
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

ENV = Path("/etc/pulse/pulse.env")
ROLES_ENV = Path("/etc/pulse/secrets/role-passwords.env")
ROLES = {"PAPI": "pulse_api_login", "PWRK": "pulse_worker_login", "PING": "pulse_ingest_login", "PPRV": "pulse_privacy_login"}


def scram(password: str) -> str:
    salt, iterations = os.urandom(16), 4096
    salted = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, iterations)
    client = hmac.new(salted, b"Client Key", "sha256").digest()
    server = hmac.new(salted, b"Server Key", "sha256").digest()
    b64 = lambda b: base64.b64encode(b).decode()  # noqa: E731
    return f"SCRAM-SHA-256${iterations}:{b64(salt)}${b64(hashlib.sha256(client).digest())}:{b64(server)}"


def read_roles() -> dict[str, str]:
    values = {}
    for line in ROLES_ENV.read_text().splitlines():
        key, sep, value = line.partition("=")
        if sep and key in ROLES:
            values[key] = value.strip().strip('"').strip("'")
    missing = set(ROLES) - set(values)
    if missing:
        raise SystemExit(f"role-passwords.env lacks {sorted(missing)}")
    return values


def write_like(path: Path, text: str) -> None:
    st = path.stat()
    tmp = path.with_name(path.name + ".rotating")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chown(tmp, st.st_uid, st.st_gid)
    os.chmod(tmp, st.st_mode & 0o777)
    os.replace(tmp, path)


def main() -> int:
    apply = "--apply" in sys.argv[1:]
    old = read_roles()
    env_text, roles_text = ENV.read_text(), ROLES_ENV.read_text()
    for key, role in ROLES.items():
        print(f"{role}: password appears {env_text.count(old[key])}x in pulse.env, {roles_text.count(old[key])}x in role-passwords.env")
        if len(old[key]) < 16:
            raise SystemExit(f"{role}: the current password is too short to replace safely")
    if not apply:
        print("dry run: nothing changed")
        return 0
    stamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
    for path in (ENV, ROLES_ENV):
        backup = path.with_name(f"{path.name}.bak-{stamp}-before-rotation")
        shutil.copy2(path, backup)
        os.chmod(backup, 0o600)
    new = {key: secrets.token_urlsafe(24) for key in ROLES}
    for key in ROLES:
        env_text, roles_text = env_text.replace(old[key], new[key]), roles_text.replace(old[key], new[key])
    sql = "begin transaction read write;\nset local log_statement = 'none';\n" + "".join(
        f"alter role {role} password '{scram(new[key])}';\n" for key, role in ROLES.items()) + "commit;\n"
    proc = subprocess.run(["docker", "exec", "-i", "pulse-postgres-1", "psql", "-U", "pulse_admin", "-d", "pulse",
                           "-X", "-q", "-v", "ON_ERROR_STOP=1"], input=sql, text=True, capture_output=True, check=False)
    if proc.returncode != 0:
        raise SystemExit(f"ALTER ROLE failed; files unchanged ({proc.returncode}): {proc.stderr.strip()[-400:]}")
    write_like(ENV, env_text)
    write_like(ROLES_ENV, roles_text)
    # Each role signs in with its new password over TCP (scram), the password on stdin, never on a command line.
    ok = True
    for key, role in ROLES.items():
        check = subprocess.run(["docker", "exec", "-i", "pulse-postgres-1", "sh", "-c",
                                f'read -r PGPASSWORD; export PGPASSWORD; psql -h "$(hostname -i | cut -d" " -f1)" -U {role} -d pulse -XAtc "select 1"'],
                               input=new[key] + "\n", text=True, capture_output=True, check=False)
        works = check.stdout.strip() == "1"
        ok = ok and works
        print(f"{role}: rotated; sign-in with the new password {'works' if works else 'FAILED: ' + check.stderr.strip()[-200:]}")
    if ok:
        # The backups hold only the old, now useless passwords: removed, so no file keeps them.
        for path in (ENV, ROLES_ENV):
            path.with_name(f"{path.name}.bak-{stamp}-before-rotation").unlink()
        print("files updated in place; the old values are gone")
    else:
        print(f"files updated in place; backups kept: *.bak-{stamp}-before-rotation (root, 600)")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
