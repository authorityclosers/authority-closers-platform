# Local-only, non-secret development contract. Production values come from Infisical.
AC_ENVIRONMENT=local
AC_RELEASE_ID=local-unreleased
AC_LOG_LEVEL=INFO
AC_DATABASE_URL=postgresql+psycopg://ac_runtime:local-runtime-only@127.0.0.1:5432/ac_platform
AC_DATABASE_MIGRATOR_URL=postgresql+psycopg://ac_migrator:local-migrator-only@127.0.0.1:5432/ac_platform
AC_SESSION_TOKEN_PEPPER=local-session-token-pepper-change-before-production
AC_OAUTH_TRANSACTION_SECRET=local-oauth-transaction-secret-change-before-production
AC_EMAIL_CHALLENGE_SECRET=local-email-challenge-secret-change-before-production
AC_EXTERNAL_SIDE_EFFECTS_HOLD=true
# Worker-only mail provider configuration. API and migrator do not receive it.
AC_EMAIL_PROVIDER=fake
AC_RESEND_API_KEY=
AC_RESEND_FROM=
# Media provider foundation is inert by default. Complete private
# storage/delivery settings and governance refs are validation data only;
# references alone never activate a provider. Shipped staging/production
# composition rejects enabled media until a later gated slice supplies an
# immutable external approval and safe transport. Do not place credentials here.
AC_MEDIA_PROVIDER_ENABLED=false
AC_MEDIA_PROVIDER=unconfigured
# Non-production stress fixtures are an explicit local-cache test seam. Keep
# unset/false in deployment environments; Settings rejects production opt-in.
# AC_MEDIA_STRESS_FIXTURES_ENABLED=false
# AC_MEDIA_STRESS_FIXTURES_CACHE_ROOT=tools/media-player-stress/.artifacts
# AC_MEDIA_STORAGE_ENDPOINT=https://s3.amazonaws.com
# AC_MEDIA_STORAGE_APPROVED_ENDPOINT_HOSTS=s3.amazonaws.com
# AC_MEDIA_STORAGE_BUCKET=
# AC_MEDIA_STORAGE_REGION=us-east-1
# AC_MEDIA_STORAGE_ACCESS_KEY_ID=
# AC_MEDIA_STORAGE_SECRET_ACCESS_KEY=
# AC_MEDIA_DELIVERY_ORIGIN=https://media.example.com
# AC_MEDIA_CORS_ORIGINS=https://app.example.com
# AC_MEDIA_GOVERNANCE_REFERENCE=AC-GOV-AUD-001
# AC_MEDIA_GAP_REFERENCE=GAP-MEDIA-001
# AC_MEDIA_MAX_PROCESSING_CAPTION_BYTES=26214400
AC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AC_PUBLIC_APP_URL=http://localhost:3000
AC_LEARNER_CONSENT_VERSION=staging-test-document-v1
AC_PUBLIC_LEARNER_TENANT_ID=
AC_OPERATIONS_TENANT_ID=
AC_ADMIN_APP_URL=http://localhost:3001
AC_API_URL=http://localhost:8000
# Optional learner-web development proxy target. Leave blank for the loopback
# API above. The only remote value accepted is the exact staging API origin,
# where localhost receives anonymous published-catalog GETs only.
AC_DEV_API_ORIGIN=
# Owner-approved, opt-in development-only authenticated staging QA bridge.
# It creates a separate local HttpOnly cookie and keeps the staging session
# server-side in ephemeral memory. Never commit staging credentials or cookies.
# AC_DEV_AUTH_BRIDGE_ENABLED=false
# AC_DEV_AUTH_BRIDGE_ORIGIN=http://localhost:3000
# AC_DEV_AUTH_BRIDGE_UPSTREAM_ORIGIN=https://staging.authorityclosers.com
# Owner-approved, opt-in development-only admin staging bridge. The launcher
# obtains the existing Cloudflare Access user token in memory and passes it to
# the admin dev process only. Never add AC_DEV_ADMIN_ACCESS_JWT to a file.
# AC_DEV_ADMIN_AUTH_BRIDGE_ENABLED=false
# AC_DEV_ADMIN_AUTH_BRIDGE_ORIGIN=http://localhost:3001
# AC_DEV_ADMIN_AUTH_BRIDGE_UPSTREAM_ORIGIN=https://admin-staging.authorityclosers.com
# AC_DEV_ADMIN_API_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_AC_API_URL=http://localhost:8000
POSTGRES_DB=ac_platform
POSTGRES_USER=ac_owner
POSTGRES_PASSWORD=local-owner-only
