{
  "manifest_version": 3,
  "name": "Sales Xray",
  "short_name": "Sales Xray",
  "version": "0.1.0",
  "description": "Add leads to Sales Xray from any page or WhatsApp Web chat with one right-click.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Sales Xray",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-48.png",
      "32": "icons/icon-48.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "storage", "scripting"],
  "optional_host_permissions": ["https://web.whatsapp.com/*"],
  "icons": {
    "16": "icons/icon-48.png",
    "32": "icons/icon-48.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-192.png"
  },
  "incognito": "not_allowed"
}
