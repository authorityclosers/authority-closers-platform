// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshots the contact policy page 1`] = `"<main class="_page_72dadb" data-policy-page="contact"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales Xray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales Xray</p><h1>Contact us</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-02">2 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>Sales Xray and seller</h2><p>Sales Xray is a product of Authority Closers. Subscriptions are sold and invoiced by Vikriya Solutions LLP, trading as Estate Autopilots.</p><dl class="_details_72dadb"><div><dt>Registered office</dt><dd>Office 102, Manorath Apartment, Plot No. 26, Sr. No. 94, Lane No. 10, Bhusari Colony (Right), Near Kothrud Depot, Kothrud, Pune 411038, Maharashtra, India</dd></div><div><dt>Email</dt><dd><a href="mailto:marketing@estateautopilots.com">marketing@estateautopilots.com</a></dd></div><div><dt>Phone</dt><dd><a href="tel:+919156281682">+91 91562 81682</a> · <a href="tel:+918668515406">+91 86685 15406</a></dd></div><div><dt>Hours</dt><dd>Monday to Saturday, 10:00–19:00 IST. We reply to email within 2 working days.</dd></div></dl></section></div></article><footer class="_footer_72dadb"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the delivery policy page 1`] = `"<main class="_page_72dadb" data-policy-page="delivery"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales Xray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales Xray</p><h1>Delivery policy</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-02">2 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>Online service</h2><p>Sales Xray is an online software service. Nothing is shipped.</p><p>Your plan and analysis minutes are added to your account after our server receives payment confirmation from Razorpay.</p><p>You use the service in your browser at the Sales Xray website. Reports are delivered in your account, and you can download them where your plan allows.</p><p>If your minutes do not appear, email us with your order number.</p></section></div></article><footer class="_footer_72dadb"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the pricing policy page 1`] = `"<main class="_page_72dadb" data-policy-page="pricing"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales Xray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales Xray</p><h1>Pricing</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-02">2 October 2026</time></p><p class="_intro_72dadb">Plan details and prices below come from the current catalogue.</p><div class="_catalogue_b3eb28" aria-label="Plans from the catalogue"><section class="_plan_b3eb28" data-plan="personal" aria-labelledby="plan-personal"><header class="_planHeader_b3eb28"><div><h2 id="plan-personal">Sample Personal</h2><p>Fictional individual plan</p></div><span class="_status_b3eb28">Available</span></header><dl class="_prices_b3eb28"><div><dt>Monthly</dt><dd>₹1,234 / month</dd></div></dl><ul class="_facts_b3eb28"><li>Analysis minutes: 40</li><li>Longest call: 30 minutes</li><li>Recording and report retention: 7 days</li><li>Seats: 1–1</li></ul><div class="_topups_b3eb28"><h3>Top-up packs</h3><ul class="_facts_b3eb28"><li>10 minutes · ₹90</li></ul></div></section><section class="_plan_b3eb28" data-plan="organisation" aria-labelledby="plan-organisation"><header class="_planHeader_b3eb28"><div><h2 id="plan-organisation">Sample Organisation</h2><p>Fictional team plan</p></div><span class="_status_b3eb28">Available</span></header><dl class="_prices_b3eb28"><div><dt>Monthly</dt><dd>₹2,345 per seat / month</dd></div></dl><ul class="_facts_b3eb28"><li>Analysis minutes: 60 per seat</li><li>Longest call: 45 minutes</li><li>Recording and report retention: 14 days</li><li>Seats: 2–5</li></ul><div class="_topups_b3eb28"><h3>Top-up packs</h3><p class="_fact_b3eb28">No top-up packs are listed in the catalogue.</p></div></section><section class="_plan_b3eb28" data-plan="enterprise" aria-labelledby="plan-enterprise"><header class="_planHeader_b3eb28"><div><h2 id="plan-enterprise">Sample Enterprise</h2><p>Fictional large team plan</p></div><span class="_status_b3eb28">Not currently on sale</span></header><dl class="_prices_b3eb28"></dl><p class="_fact_b3eb28">Price is not listed in the catalogue.</p><ul class="_facts_b3eb28"><li>Analysis minutes: not listed in the catalogue</li><li>Longest call: not listed in the catalogue</li><li>Recording and report retention: not listed in the catalogue</li><li>Seats: 6–not listed</li></ul><div class="_topups_b3eb28"><h3>Top-up packs</h3><p class="_fact_b3eb28">No top-up packs are listed in the catalogue.</p></div></section></div></article><footer class="_footer_72dadb"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the privacy policy page 1`] = `"<main class="_page_72dadb" data-policy-page="privacy"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales Xray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales Xray</p><h1>Privacy policy</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-02">2 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>Who is responsible</h2><p>Sales Xray is a product of Authority Closers. Subscriptions are sold and invoiced by Vikriya Solutions LLP, trading as Estate Autopilots, Pune. Contact: marketing@estateautopilots.com.</p></section><section class="_section_72dadb"><h2>What we collect</h2><ul><li>Account details: name, email address and mobile number.</li><li>Your recordings, transcripts and reports.</li><li>Usage and billing records, including plan, minutes and orders.</li><li>Payment card and UPI details are sent to Razorpay, not to us.</li></ul><p>If you choose Google sign-in, we receive the Google account identifier and basic profile information, including verified email and display name, needed to authenticate or link your identity. Authority Closers does not receive your Google password. Google handles its own sign-in interaction under its policies.</p><p>With Google sign-in we also keep your first and last name, language setting, your Google Workspace organization&#x27;s email domain when there is one, and our own small copy of your Google profile photo; we refresh them each time you sign in with Google.</p></section><section class="_section_72dadb"><h2>Why we use it</h2><ul><li>To provide analysis and reports.</li><li>To run your account, plan and billing.</li><li>To keep the service secure.</li><li>To meet legal and tax duties.</li></ul></section><section class="_section_72dadb"><h2>Who we share with</h2><ul><li>Hosting and analysis providers, only to run the service and under contract.</li><li>Razorpay, for payments.</li><li>We do not share your information for advertising.</li></ul></section><section class="_section_72dadb"><h2>How long we keep it</h2><p>Recordings and reports are kept for your plan&#x27;s retention period or until you delete them. Billing records are kept as tax law requires.</p></section><section class="_section_72dadb"><h2>Your rights</h2><p>Under the Digital Personal Data Protection Act, 2023, you may request access, correction, deletion and grievance redressal. Write to marketing@estateautopilots.com. We reply within 30 days.</p></section><section class="_section_72dadb"><h2>People in your calls</h2><p>You confirm that you have the required consent from people in your calls, as set out in section 4 of the Terms of service.</p></section></div></article><footer class="_footer_72dadb"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the refunds policy page 1`] = `"<main class="_page_72dadb" data-policy-page="refunds"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales Xray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales Xray</p><h1>Refund and cancellation policy</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-02">2 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>Cancellation</h2><p>You can cancel at any time to stop the next renewal. Your plan stays active until the end of the period you have paid for.</p></section><section class="_section_72dadb"><h2>Refunds</h2><ul><li>A full refund is available if you ask within 7 days of a new subscription payment and have not used any minutes from it.</li><li>Top-up packs are refundable only if none of their minutes have been used.</li></ul></section><section class="_section_72dadb"><h2>How to ask</h2><p>Email marketing@estateautopilots.com from your account email and include your order number.</p></section></div></article><footer class="_footer_72dadb"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the terms policy page 1`] = `"<main class="_page_72dadb" data-policy-page="terms"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales Xray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales Xray</p><h1>Terms of service</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-02">2 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>1. Who we are</h2><p>Sales Xray is provided by Vikriya Solutions LLP, trading as Estate Autopilots, Pune, India (&quot;we&quot;). By creating an account or paying for a plan, you agree to these terms.</p></section><section class="_section_72dadb"><h2>2. The service</h2><p>Sales Xray analyses sales-call recordings that you upload and produces written reports and coaching suggestions. Reports use automated analysis and may contain mistakes. Use them as guidance, not as the only basis for employment, legal or financial decisions.</p></section><section class="_section_72dadb"><h2>3. Your account</h2><p>Keep your sign-in secure. You are responsible for activity in your account. Organisation owners decide who joins their organisation and what members can see.</p></section><section class="_section_72dadb"><h2>4. Recordings and consent</h2><p>Upload only recordings you are allowed to use. You must have every participant&#x27;s consent to record and analyse the call, as the law that applies to you requires. Do not upload recordings of minors or special-category personal data unless the law allows it.</p></section><section class="_section_72dadb"><h2>5. Acceptable use</h2><p>Do not misuse the service, try to break its security, resell it without our written agreement, or upload unlawful content.</p></section><section class="_section_72dadb"><h2>6. Plans and payment</h2><p>Plan prices are shown in Indian rupees in the catalogue. Cancel your subscription at any time to stop the next renewal. Your plan stays active until the end of the period you have paid for. Payments are processed by Razorpay.</p></section><section class="_section_72dadb"><h2>7. Cancellation and refunds</h2><p>See the Refund and cancellation policy at /refunds.</p></section><section class="_section_72dadb"><h2>8. Your content</h2><p>You own your recordings and reports. You give us permission to store and process them to provide the service, for your plan&#x27;s retention period or until you delete them.</p></section><section class="_section_72dadb"><h2>9. Our service</h2><p>The software, report designs and analysis methods belong to us. We may change features. We will tell you before a change that reduces what a paid plan includes.</p></section><section class="_section_72dadb"><h2>10. Liability</h2><p>The service is provided &quot;as is&quot;. To the extent the law allows, our total liability for any claim is limited to the amount you paid us in the 3 months before the claim. We are not liable for indirect or consequential loss.</p></section><section class="_section_72dadb"><h2>11. Ending</h2><p>You may close your account at any time. We may suspend accounts that break these terms, after notice where reasonable.</p></section><section class="_section_72dadb"><h2>12. Law</h2><p>These terms are governed by the laws of India. The courts at Pune, Maharashtra have jurisdiction.</p></section><section class="_section_72dadb"><h2>13. Changes and contact</h2><p>We may update these terms and will show the date of the latest version. For questions, see /contact.</p></section></div></article><footer class="_footer_72dadb"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;
