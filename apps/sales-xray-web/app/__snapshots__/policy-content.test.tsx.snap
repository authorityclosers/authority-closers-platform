// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshots the contact policy page 1`] = `"<main class="_page_72dadb" data-policy-page="contact"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales X-Ray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales X-Ray</p><h1>Contact us</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-16">16 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>Sales X-Ray and seller</h2><p>Sales X-Ray is a product of Authority Closers. Subscriptions are sold and invoiced by Vikriya Solutions LLP, trading as Estate Autopilots.</p><dl class="_details_72dadb"><div><dt>Registered office</dt><dd>Office 102, Manorath Apartment, Plot No. 26, Sr. No. 94, Lane No. 10, Bhusari Colony (Right), Near Kothrud Depot, Kothrud, Pune 411038, Maharashtra, India.</dd></div><div><dt>Email</dt><dd><a href="mailto:admin@authorityclosers.com">admin@<wbr/>authorityclosers.com</a></dd></div><div><dt>Phone</dt><dd><a href="tel:+919156281682">+91 91562 81682</a> · <a href="tel:+918668515406">+91 86685 15406</a></dd></div></dl><p>For account, payment, refund, or privacy requests, email us with your account email and order number where relevant.</p></section></div></article><footer class="_footer_72dadb sx-web-only"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the data-deletion policy page 1`] = `"<main class="_page_72dadb" data-policy-page="data-deletion"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales X-Ray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales X-Ray</p><h1>Data deletion</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-20">20 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>How to ask</h2><p>Email <a href="mailto:admin@authorityclosers.com">admin@<wbr/>authorityclosers.com</a> from the email address your data is linked to, with the subject &quot;Delete my data&quot;. Say what you want deleted: your whole account, particular recordings or reports, or a lead.</p><p>If you have a Sales X-Ray account, you can also ask for a recording or report to be deleted from inside your account.</p></section><section class="_section_72dadb"><h2>Leads from Facebook or Instagram forms</h2><p>Businesses that use Sales X-Ray can receive the answers you give in their Facebook or Instagram lead forms, such as your name, phone number and email address. That business decides how it uses your details, so you can also ask it directly.</p><p>To have such a lead deleted from Sales X-Ray, email us the phone number or email address you entered in the form. We delete the lead and tell the business that we have.</p></section><section class="_section_72dadb"><h2>Businesses that connected a Facebook Page</h2><p>In Sales X-Ray, open Leads, then Sources, and disconnect the Page. New leads stop arriving at once.</p><p>To remove Sales X-Ray&#x27;s access at Meta as well, open Facebook Settings, then Business integrations, and remove Sales Xray Leads.</p><p>To delete the leads already received, or the stored connection to your Page, email us.</p></section><section class="_section_72dadb"><h2>If you signed in with Facebook</h2><p>We keep only your Facebook person id and the name and email Facebook shared, to sign you in. Ask for your account to be deleted as above and they go with it.</p><p>To remove Sales X-Ray at Facebook too, open Facebook Settings, then Apps and websites, and remove Sales Xray Sign-in.</p></section><section class="_section_72dadb"><h2>What we delete</h2><ul><li>Account details: name, email address and mobile number.</li><li>Recordings, transcripts and reports.</li><li>Leads and what is stored with them, including lead-form answers, notes and call history.</li><li>The stored connection to a Facebook Page.</li></ul></section><section class="_section_72dadb"><h2>When</h2><p>We confirm that we received your request as soon as it arrives, and complete the deletion within 2 days.</p></section><section class="_section_72dadb"><h2>What we keep</h2><ul><li>Invoices and payment records that tax law requires us to keep.</li><li>Audit records that show a request was made and carried out.</li><li>Backups and copies held by our service providers, which this request does not delete.</li></ul></section><section class="_section_72dadb"><h2>More</h2><p>See the Privacy policy at <a href="/privacy">/privacy</a>.</p></section></div></article><footer class="_footer_72dadb sx-web-only"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the delivery policy page 1`] = `"<main class="_page_72dadb" data-policy-page="delivery"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales X-Ray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales X-Ray</p><h1>Delivery policy</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-03">3 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>Online service</h2><p>Sales X-Ray is an online software service. Nothing is shipped.</p><p>Your plan and analysis minutes are added to your account after our server receives payment confirmation from Razorpay.</p><p>You use the service in your browser at the Sales X-Ray website. Reports are delivered in your account, and you can download them where your plan allows.</p><p>If your plan minutes do not appear after a successful payment, email us with your order number so we can investigate.</p></section></div></article><footer class="_footer_72dadb sx-web-only"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the pricing policy page 1`] = `"<main class="_page_72dadb" data-policy-page="pricing"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales X-Ray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales X-Ray</p><h1>Pricing</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-03">3 October 2026</time></p><p class="_intro_72dadb">Plan details and prices below come from the current catalogue. Prices are in Indian rupees.</p><div class="_catalogue_b3eb28" aria-label="Plans from the catalogue"><section class="_plan_b3eb28" data-plan="personal" aria-labelledby="plan-personal"><header class="_planHeader_b3eb28"><div><h2 id="plan-personal">Sample Personal</h2><p>Fictional individual plan</p></div><span class="_status_b3eb28">Available</span></header><dl class="_prices_b3eb28"><div><dt>Monthly</dt><dd>₹1,234 / month (GST included)</dd></div></dl><ul class="_facts_b3eb28"><li>Analysis minutes: 40</li><li>Longest call: 30 minutes</li><li>Recording and report retention: 7 days</li><li>Seats: 1</li></ul><div class="_topups_b3eb28"><h3>Top-up packs</h3><ul class="_facts_b3eb28"><li>10 minutes · ₹90 (GST included)</li></ul></div></section><section class="_plan_b3eb28" data-plan="organisation" aria-labelledby="plan-organisation"><header class="_planHeader_b3eb28"><div><h2 id="plan-organisation">Sample Organisation</h2><p>Fictional team plan</p></div><span class="_status_b3eb28">Available</span></header><dl class="_prices_b3eb28"><div><dt>Monthly</dt><dd>₹2,345 per seat / month + GST</dd></div></dl><ul class="_facts_b3eb28"><li>Analysis minutes: 60 per seat</li><li>Longest call: 45 minutes</li><li>Recording and report retention: 14 days</li><li>Seats: 2–5</li></ul><div class="_topups_b3eb28"><h3>Top-up packs</h3><p class="_fact_b3eb28">No top-up packs are listed in the catalogue.</p></div></section><section class="_plan_b3eb28" data-plan="enterprise" aria-labelledby="plan-enterprise"><header class="_planHeader_b3eb28"><div><h2 id="plan-enterprise">Sample Enterprise</h2><p>Fictional large team plan</p></div><span class="_status_b3eb28">Not currently on sale</span></header><dl class="_prices_b3eb28"></dl><p class="_fact_b3eb28">Everything in Organisation, plus priority support and an onboarding session for your team.</p><p class="_fact_b3eb28">Price is not listed in the catalogue.</p><ul class="_facts_b3eb28"><li>Analysis minutes: not listed in the catalogue</li><li>Longest call: not listed in the catalogue</li><li>Recording and report retention: not listed in the catalogue</li><li>Seats: 6 or more</li></ul><div class="_topups_b3eb28"><h3>Top-up packs</h3><p class="_fact_b3eb28">No top-up packs are listed in the catalogue.</p></div></section></div></article><footer class="_footer_72dadb sx-web-only"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the privacy policy page 1`] = `"<main class="_page_72dadb" data-policy-page="privacy"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales X-Ray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales X-Ray</p><h1>Privacy policy</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-21">21 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>Who is responsible</h2><p>Sales X-Ray is a product of Authority Closers. Subscriptions are sold and invoiced by Vikriya Solutions LLP, trading as Estate Autopilots, Pune. Contact: <a href="mailto:admin@authorityclosers.com">admin@<wbr/>authorityclosers.com</a>.</p></section><section class="_section_72dadb"><h2>What we collect</h2><ul><li>Account details: name, email address, and mobile number.</li><li>Your recordings, transcripts, and reports.</li><li>Usage and billing records, including plan, minutes, and orders.</li><li>If you use Google sign-in, the Google account identifier and basic profile information needed to authenticate or link your identity. We do not receive your Google password. We keep your first and last name, language setting, Google Workspace email domain when supplied, and a small copy of your Google profile photo.</li><li>Razorpay processes payment credentials entered in its hosted checkout. Sales X-Ray receives payment status and transaction references, not complete card credentials.</li><li>If a business connects its WhatsApp number, Facebook Page or Instagram account to Sales X-Ray: the messages people send that business there, and the business&#x27;s replies.</li></ul></section><section class="_section_72dadb"><h2>Why we use it</h2><ul><li>To provide analysis and reports.</li><li>To run your account, plan, and billing.</li><li>To keep the service secure.</li><li>To meet legal and tax duties.</li></ul></section><section class="_section_72dadb"><h2>Who we share with</h2><ul><li>Hosting and analysis service providers needed to operate Sales X-Ray. Before an analysis starts, the processing plan shows the analysis provider and purpose and asks you to accept that processing.</li><li>Razorpay for payments made through its hosted checkout.</li><li>Google (the Gemini API, provided by Google LLC), to draft replies to messages, only for a business that switches on AI replies. See AI replies to messages, below.</li><li>Sales X-Ray does not use your recordings or reports to target advertising.</li></ul></section><section class="_section_72dadb"><h2>AI service providers for call analysis</h2><ul><li>ElevenLabs (its Scribe speech-to-text API): the call audio, to transcribe the call. ElevenLabs keeps the data under its published API terms.</li><li>Google (the Gemini API, provided by Google LLC): the call transcript, to prepare and score your coaching report. Under Google&#x27;s paid Gemini API terms, the data is not used to train Google&#x27;s models.</li><li>OpenAI (the OpenAI API, provided by OpenAI, L.L.C., USA): the call transcript as text, never the audio, to prepare and score your coaching report. Data sent to the OpenAI API is not used to train OpenAI&#x27;s models. Sales X-Ray asks OpenAI not to store its answers. OpenAI keeps API data in its abuse-monitoring logs for up to 30 days, or longer only where the law requires; once OpenAI grants zero data retention for Sales X-Ray, it keeps none there.</li></ul><p>Before an analysis starts, the upload terms for that call name which of these providers will process it, and you accept that processing. These providers may process the data outside India.</p></section><section class="_section_72dadb"><h2>AI replies to messages</h2><p>A business that uses Sales X-Ray can switch on AI replies for the messages people send it on WhatsApp, Messenger or Instagram. To draft a reply, Sales X-Ray then sends Google (the Gemini API, provided by Google LLC) the business&#x27;s own description of itself and the words of up to the last 10 messages in that one conversation. If the person did not come from a Facebook or Instagram lead form, their first name is sent too.</p><p>Sales X-Ray does not send Google the answers given in Facebook or Instagram lead forms, or the phone number or email address saved with a lead.</p><p>The business chooses whether a person at the business reads each draft before it is sent, or whether replies are sent automatically. AI replies answer only about the business, hand the conversation to a person on complaints, on anything they cannot answer from the business&#x27;s own description, or when you ask for a person, and stop when you reply STOP.</p></section><section class="_section_72dadb"><h2>How long we keep it</h2><p>The plan and accepted processing plan show the retention period for recordings and reports. You may request deletion from your account. A deletion request queues removal from active Sales X-Ray stores. Audit records remain. This deletion path does not delete backups or provider-held copies; their separate retention periods are not stated here. Transaction and audit records may remain after account closure.</p></section><section class="_section_72dadb"><h2>Your rights</h2><p>You may contact us about access, correction, or deletion of your personal data, or to raise a grievance. Email <a href="mailto:admin@authorityclosers.com">admin@<wbr/>authorityclosers.com</a>. We handle requests under applicable law.</p><p>To ask for deletion, including leads from Facebook or Instagram lead forms, see <a href="/data-deletion">/data-deletion</a>.</p></section><section class="_section_72dadb"><h2>People in your calls</h2><p>You confirm that you have the required consent from people in your calls, as set out in section 4 of the Terms of service.</p></section></div></article><footer class="_footer_72dadb sx-web-only"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the refunds policy page 1`] = `"<main class="_page_72dadb" data-policy-page="refunds"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales X-Ray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales X-Ray</p><h1>Refund and cancellation policy</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-16">16 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>Cancellation</h2><p>You can cancel at any time to stop the next renewal. Your plan stays active until the end of the period you have paid for. We do not charge a cancellation fee.</p></section><section class="_section_72dadb"><h2>Subscription refunds</h2><p>If you ask within 7 days of a new subscription payment and have not used any minutes from it, we refund the full amount.</p><p>After you use minutes, that period&#x27;s payment is not refundable. Unused minutes do not turn into money.</p></section><section class="_section_72dadb"><h2>Top-up refunds</h2><p>Top-up packs are refundable within 7 days only if none of the pack&#x27;s minutes have been used.</p></section><section class="_section_72dadb"><h2>Failed, duplicate, or incorrect charges</h2><p>Failed, duplicate or wrongly charged payments are refunded in full. To report a problem, email <a href="mailto:admin@authorityclosers.com">admin@<wbr/>authorityclosers.com</a> from your account email and include the order number.</p></section><section class="_section_72dadb"><h2>How refunds are paid</h2><p>Refunds are paid to the original payment method through Razorpay. The provider and your bank control when the credit appears.</p></section><section class="_section_72dadb"><h2>How to ask</h2><p>Email <a href="mailto:admin@authorityclosers.com">admin@<wbr/>authorityclosers.com</a> from your account email and include your order number.</p></section><section class="_section_72dadb"><h2>Organisation plans</h2><p>Only the organisation owner can cancel or ask for a refund.</p></section></div></article><footer class="_footer_72dadb sx-web-only"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;

exports[`snapshots the terms policy page 1`] = `"<main class="_page_72dadb" data-policy-page="terms"><header class="_top_72dadb"><a class="_brand_72dadb" href="/">Sales X-Ray</a></header><article class="_content_72dadb"><p class="_eyebrow_72dadb">Sales X-Ray</p><h1>Terms of service</h1><p class="_updated_72dadb">Last updated <time dateTime="2026-10-03">3 October 2026</time></p><div class="_sections_72dadb"><section class="_section_72dadb"><h2>1. Who we are</h2><p>Sales X-Ray is provided by Vikriya Solutions LLP, trading as Estate Autopilots, Pune, India (&quot;we&quot;). By creating an account or paying for a plan, you agree to these terms.</p></section><section class="_section_72dadb"><h2>2. The service</h2><p>Sales X-Ray analyses sales-call recordings that you upload and produces written reports and coaching suggestions. Reports use automated analysis and may contain mistakes. Use them as guidance, not as the only basis for employment, legal or financial decisions.</p></section><section class="_section_72dadb"><h2>3. Your account</h2><p>Keep your sign-in secure. You are responsible for activity in your account. Organisation owners decide who joins their organisation and what members can see.</p></section><section class="_section_72dadb"><h2>4. Recordings and consent</h2><p>Upload only recordings you are allowed to use. You must have every participant&#x27;s consent to record and analyse the call, as the law that applies to you requires. Do not upload recordings of minors or special-category personal data unless the law allows it.</p></section><section class="_section_72dadb"><h2>5. Acceptable use</h2><p>Do not misuse the service, try to break its security, resell it without our written agreement, or upload unlawful content.</p></section><section class="_section_72dadb"><h2>6. Plans and payment</h2><ul><li>Plan prices, billing intervals, and included details are shown in the current catalogue and at checkout. Review the amount shown before you confirm payment.</li><li>Monthly and yearly subscriptions continue under the payment authorization and provider rules for the selected plan. A later charge may require approval from your bank or payment method. We do not promise a separate Sales X-Ray reminder before each renewal.</li><li>You can cancel at any time to stop the next renewal. Your current paid period remains active until it ends.</li><li>Usage is based on the duration processed for each analysed recording. Minutes expire or roll over as shown in the plan details.</li><li>Plan payments use Razorpay hosted checkout. Razorpay handles payment credentials entered there. Sales X-Ray receives payment status and transaction references needed to provide the service, not complete card credentials.</li></ul></section><section class="_section_72dadb"><h2>7. Cancellation and refunds</h2><p>See the Refund and cancellation policy at /refunds.</p></section><section class="_section_72dadb"><h2>8. Your content</h2><p>You own your recordings and reports. We use them to provide the service for the retention period shown in the applicable plan and processing notice. You may request deletion from your account. A deletion request queues removal from active Sales X-Ray stores. Audit records remain, and this process does not delete backups or provider-held copies; separate retention periods for those copies are not stated here.</p></section><section class="_section_72dadb"><h2>9. Our service</h2><p>The software, report designs and analysis methods belong to us. We may change features. We will tell you before a change that reduces what a paid plan includes.</p></section><section class="_section_72dadb"><h2>10. Liability</h2><p>The service is provided &quot;as is&quot;. To the extent the law allows, our total liability for any claim is limited to the amount you paid us in the 3 months before the claim. We are not liable for indirect or consequential loss.</p></section><section class="_section_72dadb"><h2>11. Ending</h2><p>You may close your account at any time. We may suspend accounts that break these terms, after notice where reasonable.</p></section><section class="_section_72dadb"><h2>12. Law</h2><p>These terms are governed by the laws of India. The courts at Pune, Maharashtra have jurisdiction.</p></section><section class="_section_72dadb"><h2>13. Changes and contact</h2><p>We may update these terms and will show the date of the latest version. For questions, see /contact.</p></section></div></article><footer class="_footer_72dadb sx-web-only"><nav aria-label="Sales Xray policy pages"><ul class="_footerLinks_72dadb"><li><a href="/pricing">Pricing</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/refunds">Refunds</a></li><li><a href="/delivery">Delivery</a></li><li><a href="/contact">Contact</a></li></ul></nav></footer></main>"`;
